---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Preloader from '../components/Preloader.astro';
import CustomCursor from '../components/CustomCursor.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title = "TurisRan Dominicana | Transfers & Experiencias — Viaja cómodo. Llega seguro.",
  description = "Servicio de transporte privado VIP en la República Dominicana. Traslados desde aeropuertos de Punta Cana (PUJ), Santo Domingo (SDQ), Santiago (STI) y tours exclusivos.",
  image = "/images/logo-turisran.webp"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://turisran-dominicana.com");
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#D4AF37" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:site_name" content="TurisRan Dominicana" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Preload LCP Hero Image -->
    <link rel="preload" as="image" type="image/webp" href="/images/santo-domingo-noche.webp" fetchpriority="high" />

    <!-- Self-hosted Fonts (eliminates fonts.googleapis.com + fonts.gstatic.com DNS/TLS) -->
    <link rel="stylesheet" href="/fonts/fonts.css" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="/fonts/fonts.css" />
    </noscript>


    <!-- Schema.org Structured Data (Local SEO & NAP Optimization) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": ["TravelAgency", "LocalBusiness"],
        "name": "TurisRan Dominicana | Transporte & Tours",
        "alternateName": "TurisRan Dominicana",
        "image": "https://turisran-dominicana.com/images/TurisRan%20logo.png",
        "@id": "https://turisran-dominicana.com/#organization",
        "url": "https://turisran-dominicana.com",
        "telephone": "+1-849-752-7408",
        "email": "info@turisran-dominicana.com",
        "priceRange": "$$",
        "currenciesAccepted": "USD, DOP, EUR",
        "paymentAccepted": "Cash, Bank Transfer",
        "description": "Servicio de transporte privado VIP en la República Dominicana. Traslados desde aeropuertos de Punta Cana (PUJ), Santo Domingo (SDQ), Santiago (STI) y tours exclusivos.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Punta Cana / Santo Domingo",
          "addressLocality": "Punta Cana",
          "addressRegion": "La Altagracia",
          "postalCode": "23000",
          "addressCountry": "DO"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 18.6698995,
          "longitude": -70.130055
        },
        "hasMap": "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r",
        "areaServed": [
          { "@type": "City", "name": "Punta Cana" },
          { "@type": "City", "name": "Santo Domingo" },
          { "@type": "City", "name": "Santiago de los Caballeros" },
          { "@type": "City", "name": "Puerto Plata" },
          { "@type": "City", "name": "La Romana" },
          { "@type": "City", "name": "Bayahíbe" },
          { "@type": "City", "name": "Samaná" },
          { "@type": "Country", "name": "República Dominicana" }
        ],
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
          ],
          "opens": "00:00",
          "closes": "23:59"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "reviewCount": "50",
          "bestRating": "5",
          "worstRating": "1"
        },
        "sameAs": [
          "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r",
          "https://www.facebook.com/profile.php?id=61577764472405",
          "https://www.tiktok.com/",
          "https://wa.me/18497527408"
        ]
      }
    </script>
  </head>
  <body class="bg-[#0A0A0A] text-[#F7F5F0] antialiased selection:bg-[#D4AF37] selection:text-[#0A0A0A] min-h-screen flex flex-col justify-between">
    <CustomCursor />
    <Preloader />
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <!-- GSAP & ScrollTrigger (self-hosted, eliminates cdnjs.cloudflare.com DNS/TLS) -->
    <script is:inline defer src="/js/gsap.min.js"></script>
    <script is:inline defer src="/js/ScrollTrigger.min.js"></script>
    <ScrollAnimations />
  </body>
</html>
