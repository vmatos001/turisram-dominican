---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página No Encontrada (404) | TurisRan Dominicana"
  description="La página que buscas no existe o ha sido movida. Vuelve al inicio o contáctanos para coordinar tu traslado VIP en República Dominicana."
>
  <main class="min-h-[85vh] bg-[#030303] text-white flex items-center justify-center relative overflow-hidden py-24 px-4 sm:px-6 lg:px-8">
    
    <!-- Luces y Resplandor de Fondo -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 sm:w-[500px] sm:h-[500px] bg-[#D4AF37]/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-72 h-72 bg-[#3B6998]/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto text-center space-y-8">
      
      <!-- Cápsula Dorada -->
      <div data-reveal="fade-down" class="inline-flex items-center gap-2">
        <span class="text-[#D4AF37] animate-spin text-sm">✱</span>
        <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-lg">
          ERROR 404 — RUTA NO ENCONTRADA
        </span>
      </div>

      <!-- Gran 404 Estilizado -->
      <div data-reveal="zoom-center" data-delay="0.1" class="relative">
        <h1 class="text-8xl sm:text-9xl lg:text-[11rem] font-black font-['Barlow_Condensed'] tracking-tighter leading-none select-none text-transparent bg-clip-text bg-gradient-to-b from-[#FFF2B2] via-[#D4AF37] to-[#8C6D15] drop-shadow-[0_15px_35px_rgba(212,175,55,0.3)]">
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center opacity-10 pointer-events-none">
          <span class="text-9xl sm:text-[13rem] font-black font-['Barlow_Condensed'] tracking-widest text-[#D4AF37] blur-sm">
            TURISRAN
          </span>
        </div>
      </div>

      <!-- Mensaje Principal -->
      <div data-reveal="fade-up" data-delay="0.2" class="space-y-4 max-w-xl mx-auto">
        <h2 class="text-2xl sm:text-4xl font-extrabold font-['Barlow_Condensed'] uppercase tracking-tight text-white leading-tight">
          Parece que te has <span class="text-[#D4AF37]">desviado del camino</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-300 font-['Barlow_Semi_Condensed'] leading-relaxed">
          La página que buscas no existe, cambió de dirección o se encuentra temporalmente fuera de servicio. Nuestro equipo de choferes VIP te llevará de regreso seguro a tu destino.
        </p>
      </div>

      <!-- Botones de Acción Inmediata -->
      <div data-reveal="fade-up" data-delay="0.3" class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#D4AF37] hover:bg-[#c49f2e] text-[#0A0A0A] font-extrabold text-sm uppercase tracking-wider px-8 py-3.5 rounded-full shadow-lg hover:shadow-[0_10px_30px_rgba(212,175,55,0.4)] transition-all duration-300 transform hover:-translate-y-0.5 font-['Barlow_Condensed']"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Volver al Inicio
        </a>

        <a
          href="/servicios"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-transparent hover:bg-white/5 border border-[#D4AF37]/50 hover:border-[#D4AF37] text-white font-bold text-sm uppercase tracking-wider px-8 py-3.5 rounded-full transition-all duration-300 font-['Barlow_Condensed']"
        >
          Explorar Servicios
        </a>

        <a
          href="https://wa.me/18497527408?text=Hola%2C%20estaba%20navegando%20en%20el%20sitio%20web%20y%20necesito%20asistencia%20con%20una%20reserva"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-sm uppercase tracking-wider px-6 py-3.5 rounded-full shadow-md hover:shadow-lg transition-all duration-300 font-['Barlow_Condensed']"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Soporte 24/7
        </a>
      </div>

      <!-- Accesos Rápidos en Cuadrícula -->
      <div data-reveal="fade-up" data-delay="0.4" class="pt-10 border-t border-white/10 max-w-2xl mx-auto">
        <p class="text-xs uppercase tracking-widest text-[#D4AF37] font-extrabold font-['Barlow_Condensed'] mb-5">
          Enlaces de Navegación Rápida
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
          <a
            href="/"
            class="p-3.5 rounded-xl bg-[#0d0d0d] border border-white/5 hover:border-[#D4AF37]/40 hover:bg-[#141409] transition-all group"
          >
            <span class="block text-xs font-bold text-gray-300 group-hover:text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider">
              Inicio
            </span>
          </a>
          <a
            href="/nosotros"
            class="p-3.5 rounded-xl bg-[#0d0d0d] border border-white/5 hover:border-[#D4AF37]/40 hover:bg-[#141409] transition-all group"
          >
            <span class="block text-xs font-bold text-gray-300 group-hover:text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider">
              Nosotros
            </span>
          </a>
          <a
            href="/servicios"
            class="p-3.5 rounded-xl bg-[#0d0d0d] border border-white/5 hover:border-[#D4AF37]/40 hover:bg-[#141409] transition-all group"
          >
            <span class="block text-xs font-bold text-gray-300 group-hover:text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider">
              Servicios
            </span>
          </a>
          <a
            href="/contacto"
            class="p-3.5 rounded-xl bg-[#0d0d0d] border border-white/5 hover:border-[#D4AF37]/40 hover:bg-[#141409] transition-all group"
          >
            <span class="block text-xs font-bold text-gray-300 group-hover:text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider">
              Contacto
            </span>
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>
