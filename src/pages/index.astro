<!-- SCRIPTS INTERACTIVOS: 1) BOTÓN MAGNÉTICO AL CURSOR  2) SCROLL SCRUB DIAGONAL EN TIEMPO REAL (REVERSIBLE FOTOGRAMA A FOTOGRAMA) -->
<script is:inline>
  // 1. Botón Magnético que persigue el cursor suavemente
  const roadSection = document.getElementById('scrub-road-section');
  const magnetBtn = document.getElementById('magnet-btn');

  if (roadSection && magnetBtn) {
    roadSection.addEventListener('mousemove', (e) => {
      const rect = magnetBtn.getBoundingClientRect();
      const btnCenterX = rect.left + rect.width / 2;
      const btnCenterY = rect.top + rect.height / 2;

      const distX = (e.clientX - btnCenterX) * 0.22;
      const distY = (e.clientY - btnCenterY) * 0.22;

      magnetBtn.style.transform = `translate3d(${distX}px, ${distY}px, 0)`;
    });

    roadSection.addEventListener('mouseleave', () => {
      magnetBtn.style.transform = 'translate3d(0, 0, 0)';
    });
  }

  // 2. SCROLL SCRUB DIAGONAL EN TIEMPO REAL: avance y retroceso continuo en función del avance del scroll
  const scrubCards = document.querySelectorAll('.scrub-card');
  const gridContainer = document.getElementById('scrub-cards-grid');

  function updateScrubCards() {
    if (!gridContainer) return;

    const rect = gridContainer.getBoundingClientRect();
    const windowHeight = window.innerHeight;

    // Calcular progreso del scroll de 0 a 1 conforme el contenedor entra en la pantalla
    const startY = windowHeight * 0.9;
    const endY = windowHeight * 0.2;
    let progress = (startY - rect.top) / (startY - endY);
    progress = Math.max(0, Math.min(1, progress));

    scrubCards.forEach((card, idx) => {
      const dir = (idx % 2 === 0) ? -1 : 1;
      const moveX = (1 - progress) * 120 * dir; // Movimiento horizontal diagonal
      const moveY = (1 - progress) * 160;        // Movimiento vertical
      const opacity = Math.max(0.1, progress);

      card.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
      card.style.opacity = `${opacity}`;
    });
  }

  window.addEventListener('scroll', updateScrubCards, { passive: true });
  window.addEventListener('resize', updateScrubCards, { passive: true });
  updateScrubCards();
</script>
