---
import Layout from '../layouts/Layout.astro';
import QuoteModal from '../components/QuoteModal.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

const services = [
  {
    title: "Traslado Aeropuerto -> Hotel",
    desc: "Servicio puntual desde aeropuertos PUJ, SDQ, LRM, STI, POP directamente a tu hotel o resort. Chofer esperándote con cartel personalizado.",
    icon: "✈️",
    image: "/images/create-a-high-quality-image-showing-a-airport--gre.webp"
  },
  {
    title: "Transporte Privado VIP",
    desc: "Vehículos ejecutivos y SUVs climatizados de alta gama para ejecutivos, parejas y familias que buscan máxima comodidad y privacidad.",
    icon: "🚐",
    image: "/images/a-black-luxuru-van-c.webp"
  },
  {
    title: "Transporte para Grupos",
    desc: "Minibuses y buses de gran capacidad para eventos corporativos, bodas de destino, excursiones familiares y grupos turísticos.",
    icon: "🚌",
    image: "/images/generate-an-image-of-a-professional-transportation.webp"
  },
  {
    title: "Tours y Excursiones Privadas",
    desc: "Conoce las maravillas de República Dominicana: Isla Saona, Samaná, Los Haitises, Jarabacoa, Bahía de las Águilas y más a tu propio ritmo.",
    icon: "🏝️",
    image: "/images/create-a-stunning-and-vibrant-image-for-the--explo.webp"
  }
];

const pillars = [
  { title: "Sin Esperas en Aeropuerto", desc: "Monitoreamos tu vuelo en tiempo real. Tu chofer estará listo cuando aterrices.", icon: "⚡" },
  { title: "Tarifa Fija Garantizada", desc: "El precio pactado es el precio final. Sin cargos ocultos ni sorpresas al llegar.", icon: "🏷️" },
  { title: "Choferes Profesionales", desc: "Conductores certificados, bilingües y con amplio conocimiento de todo el país.", icon: "👨‍✈️" },
  { title: "Atención 24/7 por WhatsApp", desc: "Soporte personalizado constante antes, durante y después de tu viaje.", icon: "📱" }
];
---

<Layout title="TurisRam Dominican | Transporte Privado & Tours en Punta Cana">
  
  <!-- HERO SECTION -->
  <section class="relative min-h-[90vh] flex items-center justify-center bg-[#030303] text-white overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/a-black-luxuru-van-c.webp"
        alt="Transporte Privado TurisRam Dominican"
        class="w-full h-full object-cover animate-subtle-zoom opacity-40"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#030303] via-[#123458]/70 to-[#030303]/80"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center py-20">
      <span class="inline-block bg-[#D4C9BE] text-[#123458] font-bold text-xs px-4 py-1.5 rounded-full uppercase tracking-widest mb-6 font-['Montserrat'] shadow-lg">
        República Dominicana & Punta Cana
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold font-['Montserrat'] tracking-tight leading-tight mb-6">
        Transporte Privado & Tours VIP <br />
        <span class="text-[#D4C9BE]">Viaja Seguro y a Tarifa Fija</span>
      </h1>
      <p class="text-base sm:text-xl text-[#F1EFEC]/90 max-w-3xl mx-auto mb-10 font-normal leading-relaxed">
        Olvídate del estrés en el aeropuerto. Chofer profesional con cartel personalizado, vehículos climatizados de lujo y confirmación instantánea por WhatsApp.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20cotizar%20un%20traslado%20privado"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto bg-[#D4C9BE] text-[#123458] font-bold px-8 py-4 rounded-full text-base hover:bg-white transition-all duration-300 shadow-xl font-['Montserrat'] flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.758zm6.657-4.148l.38.225c1.47.872 3.176 1.332 4.92 1.333 5.385 0 9.768-4.383 9.771-9.768.002-2.607-1.013-5.059-2.86-6.907-1.847-1.847-4.298-2.862-6.906-2.863-5.386 0-9.77 4.384-9.773 9.77-.001 1.794.49 3.541 1.42 5.061l.247.4-.954 3.484 3.575-.935z"/></svg>
          Cotizar por WhatsApp
        </a>
        <a
          href="/servicios"
          class="w-full sm:w-auto bg-white/10 border border-white/30 text-white font-bold px-8 py-4 rounded-full text-base hover:bg-white/20 transition-all duration-300 font-['Montserrat']"
        >
          Explorar Servicios & Tours
        </a>
      </div>
    </div>
  </section>

  <!-- QUOTE WIDGET -->
  <section class="max-w-7xl mx-auto px-4 -mt-12 relative z-20">
    <QuoteModal />
  </section>

  <!-- NUESTROS SERVICIOS -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-[#123458] font-bold text-xs uppercase tracking-widest font-['Montserrat']">Servicios Principales</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#123458] font-['Montserrat'] mt-2">
        Soluciones de Transporte a Tu Medida
      </h2>
      <p class="text-gray-600 mt-2 max-w-2xl mx-auto text-sm">
        Te llevamos a cualquier rincón de la República Dominicana con total confort, privacidad y conductores profesionales.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map(svc => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col group">
          <div class="relative h-48 overflow-hidden">
            <img
              src={svc.image}
              alt={svc.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-3 left-3 bg-[#123458] text-white p-2 rounded-xl text-xl shadow-md">
              {svc.icon}
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-bold text-[#123458] font-['Montserrat'] mb-2">{svc.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed mb-4">{svc.desc}</p>
            </div>
            <a
              href="https://wa.me/18497527408?text=¡Hola!%20Me%20interesa%20información%20sobre:%20"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold text-[#123458] hover:text-[#D4C9BE] inline-flex items-center gap-1 font-['Montserrat'] uppercase tracking-wider"
            >
              Consultar Disponibilidad &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- POR QUE ELEGIRNOS -->
  <section class="py-20 bg-[#123458] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="bg-[#D4C9BE] text-[#123458] text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider font-['Montserrat']">
          Ventajas TurisRam
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold font-['Montserrat'] mt-3 text-white">
          ¿Por qué Elegir TurisRam Dominican?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {pillars.map(pil => (
          <div class="bg-[#030303]/30 border border-white/10 p-8 rounded-2xl text-center hover:border-[#D4C9BE] transition-all duration-300">
            <div class="text-4xl mb-4">{pil.icon}</div>
            <h3 class="text-lg font-bold text-[#D4C9BE] font-['Montserrat'] mb-2">{pil.title}</h3>
            <p class="text-xs text-gray-300 leading-relaxed">{pil.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GOOGLE REVIEWS SECTION -->
  <GoogleReviews />

  <!-- SECTION CONOCENOS -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl">
        <img
          src="/images/create-a-warm-and-professional-header-image-for-th.webp"
          alt="Equipo TurisRam Dominican"
          class="w-full h-[400px] object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#123458]/80 to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 text-white">
          <span class="font-bold text-xs uppercase tracking-widest text-[#D4C9BE]">TurisRam Dominican</span>
          <p class="text-lg font-bold font-['Montserrat']">Comprometidos con tu tranquilidad y puntualidad en cada trayecto.</p>
        </div>
      </div>

      <div class="space-y-6">
        <span class="text-[#123458] font-bold text-xs uppercase tracking-widest font-['Montserrat']">Conócenos</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#123458] font-['Montserrat'] leading-tight">
          Tu Socio de Confianza en Transporte Turístico
        </h2>
        <p class="text-sm text-gray-600 leading-relaxed">
          TurisRam Dominican nace para ofrecer a los visitantes de la República Dominicana una experiencia de transporte de primera categoría. Con choferes capacitados, flota propia moderna y atención constante las 24 horas, transformamos tu traslado en el inicio perfecto de tus vacaciones.
        </p>

        <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-200">
          <div>
            <span class="text-3xl font-extrabold text-[#123458] font-['Montserrat']">+500</span>
            <p class="text-xs text-gray-500">Clientes Satisfechos</p>
          </div>
          <div>
            <span class="text-3xl font-extrabold text-[#123458] font-['Montserrat']">+15</span>
            <p class="text-xs text-gray-500">Destinos Turísticos</p>
          </div>
        </div>

        <div>
          <a
            href="/nosotros"
            class="inline-block bg-[#123458] text-white font-bold px-6 py-3 rounded-full text-sm hover:bg-[#030303] transition-all duration-300 font-['Montserrat'] shadow-md"
          >
            Leer Más Sobre Nosotros &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
