---
import Layout from '../layouts/Layout.astro';
import QuoteModal from '../components/QuoteModal.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

const pillars = [
  { 
    title: "Sin Esperas en Aeropuerto", 
    desc: "Monitoreamos tu vuelo en tiempo real. Tu chofer estará listo con cartel personalizado cuando aterrices.", 
    svg: `<svg class="w-6 h-6 text-[#D4AF37] fill-current" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>` 
  },
  { 
    title: "Tarifa Fija Garantizada", 
    desc: "El precio pactado previamente por WhatsApp es el precio final. Sin cargos ocultos ni sorpresas al llegar.", 
    svg: `<svg class="w-6 h-6 text-[#D4AF37] fill-current" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>` 
  },
  { 
    title: "Choferes Profesionales", 
    desc: "Conductores certificados, bilingües y con amplio conocimiento de todo el país y las principales rutas.", 
    svg: `<svg class="w-6 h-6 text-[#D4AF37] fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>` 
  },
  { 
    title: "Atención 24/7 por WhatsApp", 
    desc: "Soporte personalizado constante antes, durante y después de tu viaje a cualquier hora del día.", 
    svg: `<svg class="w-6 h-6 text-[#D4AF37] fill-current" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>` 
  }
];
---

<Layout title="TurisRam Dominicana | Transfers & Experiencias — Viaja cómodo. Llega seguro.">
  
  <!-- HERO SECTION -->
  <section class="relative min-h-[92vh] flex items-center justify-center bg-[#050505] text-white overflow-hidden border-b border-[#D4AF37]/20">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/a-black-luxuru-van-c.webp"
        alt="Transporte Privado TurisRam Dominicana"
        class="w-full h-full object-cover animate-subtle-zoom opacity-40"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/75 to-[#050505]/90"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      
      <!-- Live Status Pill -->
      <div class="inline-flex items-center gap-2.5 bg-[#050505]/80 border border-[#D4AF37]/40 px-5 py-2 rounded-full text-xs font-extrabold text-[#F7F5F0] mb-8 backdrop-blur-md font-['Barlow_Condensed'] uppercase tracking-wider shadow-xl">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
        <span class="text-[#D4AF37]">Choferes VIP Disponibles en Tiempo Real</span>
        <span class="hidden sm:inline text-gray-400">• PUJ, SDQ, LRM</span>
      </div>

      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold font-['Barlow_Condensed'] tracking-tight leading-[1] mb-4 uppercase">
        TurisRam <span class="text-[#3B6998]">DOMINICANA</span> <br />
        <span class="text-[#D4AF37]">Transfers & Experiencias</span>
      </h1>

      <p class="text-xl sm:text-3xl text-[#D4AF37] max-w-3xl mx-auto mb-6 font-['Lora'] italic">
        "Viaja cómodo. Llega seguro."
      </p>

      <p class="text-sm sm:text-base text-[#F7F5F0]/85 max-w-2xl mx-auto mb-10 font-normal leading-relaxed font-['Barlow_Semi_Condensed']">
        Olvídate del estrés en el aeropuerto. Chofer profesional con cartel personalizado, vehículos climatizados de lujo y confirmación instantánea por WhatsApp.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <a
          href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20cotizar%20un%20traslado%20privado"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto bg-[#D4AF37] text-[#050505] font-extrabold text-xs uppercase tracking-widest px-8 py-4 rounded-full hover:bg-white transition-all duration-300 shadow-2xl font-['Barlow_Condensed'] flex items-center justify-center gap-2 border border-white/20"
        >
          <svg class="w-4 h-4 fill-current text-[#050505]" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.758zm6.657-4.148l.38.225c1.47.872 3.176 1.332 4.92 1.333 5.385 0 9.768-4.383 9.771-9.768.002-2.607-1.013-5.059-2.86-6.907-1.847-1.847-4.298-2.862-6.906-2.863-5.386 0-9.77 4.384-9.773 9.77-.001 1.794.49 3.541 1.42 5.061l.247.4-.954 3.484 3.575-.935z"/></svg>
          Cotizar por WhatsApp
        </a>
        <a
          href="/servicios"
          class="w-full sm:w-auto bg-white/10 border border-white/30 text-white font-extrabold text-xs uppercase tracking-widest px-8 py-4 rounded-full hover:bg-white/20 transition-all duration-300 font-['Barlow_Condensed'] backdrop-blur-sm"
        >
          Explorar Servicios & Tours
        </a>
      </div>

    </div>
  </section>

  <!-- QUOTE ENGINE WIDGET -->
  <section class="max-w-7xl mx-auto px-4 -mt-14 relative z-20">
    <QuoteModal />
  </section>

  <!-- BENTO GRID ASIMETRICO DE SERVICIOS & TOURS -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-[#D4AF37] font-extrabold text-xs uppercase tracking-widest font-['Barlow_Condensed']">Catálogo Bento Executive</span>
      <h2 class="text-4xl sm:text-6xl font-extrabold text-[#F7F5F0] font-['Barlow_Condensed'] mt-1 tracking-wide uppercase">
        Servicios & Excursiones Destacadas
      </h2>
      <p class="text-gray-400 mt-2 max-w-2xl mx-auto text-sm font-['Barlow_Semi_Condensed']">
        Descubre nuestra oferta de traslados ejecutivos y tours privados en la República Dominicana.
      </p>
    </div>

    <!-- Bento Grid Layout Tourvex Style -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
      
      <!-- Bento Item 1 (Large Featured - Span 2 Cols, 2 Rows) -->
      <div class="md:col-span-2 md:row-span-2 bg-[#050505] text-white rounded-3xl overflow-hidden shadow-2xl relative flex flex-col justify-between group border border-[#D4AF37]/30 zoom-image-wrapper">
        <div class="absolute inset-0 z-0">
          <img
            src="/images/Isla Saona.webp"
            alt="Tour Isla Saona VIP"
            class="w-full h-full object-cover opacity-60"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/40 to-transparent"></div>
        </div>

        <div class="relative z-10 p-8 flex justify-between items-start">
          <span class="bg-[#D4AF37] text-[#050505] text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-wider font-['Barlow_Condensed'] shadow-md">
            Tour Más Popular
          </span>
          <span class="glass-card text-white text-xs font-extrabold px-3 py-1 rounded-lg font-['Barlow_Condensed']">
            Full Day VIP
          </span>
        </div>

        <div class="relative z-10 p-8">
          <h3 class="text-3xl sm:text-4xl font-extrabold font-['Barlow_Condensed'] mb-2 text-[#D4AF37] uppercase">
            Isla Saona VIP & Piscina Natural
          </h3>
          <p class="text-xs sm:text-sm text-gray-200 leading-relaxed mb-6 max-w-lg font-['Barlow_Semi_Condensed']">
            Navega en catamarán de lujo por aguas cristalinas, disfruta de almuerzo buffet típico frente al mar y nada con estrellas de mar gigantes.
          </p>

          <div class="flex items-center gap-4 pt-4 border-t border-white/20">
            <a
              href="https://wa.me/18497527408?text=¡Hola!%20Me%20interesa%20reservar%20el%20tour%20Isla%20Saona%20VIP"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-[#D4AF37] text-[#050505] font-extrabold text-xs uppercase tracking-widest px-6 py-3 rounded-full hover:bg-white transition-all font-['Barlow_Condensed'] shadow-lg inline-flex items-center gap-2"
            >
              Reservar Tour por WhatsApp &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Bento Item 2 (Standard Item 1) -->
      <div class="glass-card rounded-3xl p-6 shadow-lg flex flex-col justify-between group hover:border-[#D4AF37]/50 transition-all duration-300 zoom-image-wrapper">
        <div>
          <div class="h-40 rounded-2xl overflow-hidden mb-4 relative">
            <img src="/images/create-a-high-quality-image-showing-a-airport--gre.webp" alt="Traslado Aeropuerto" class="w-full h-full object-cover" />
          </div>
          <h4 class="font-extrabold text-xl text-[#D4AF37] font-['Barlow_Condensed'] mb-1 uppercase">Traslado Aeropuerto PUJ / SDQ</h4>
          <p class="text-xs text-gray-400 leading-relaxed font-['Barlow_Semi_Condensed']">Monitoreo de vuelo en vivo y chofer esperándote en la puerta con cartel personalizado.</p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs font-extrabold text-[#3B6998] uppercase font-['Barlow_Condensed']">Puntualidad 100%</span>
          <a href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20cotizar%20traslado%20de%20aeropuerto" class="text-xs font-bold text-[#D4AF37] hover:underline font-['Barlow_Condensed']">Cotizar &rarr;</a>
        </div>
      </div>

      <!-- Bento Item 3 (Standard Item 2) -->
      <div class="glass-card rounded-3xl p-6 shadow-lg flex flex-col justify-between group hover:border-[#D4AF37]/50 transition-all duration-300 zoom-image-wrapper">
        <div>
          <div class="h-40 rounded-2xl overflow-hidden mb-4 relative">
            <img src="/images/a-black-luxuru-van-c.webp" alt="Transporte Privado VIP" class="w-full h-full object-cover" />
          </div>
          <h4 class="font-extrabold text-xl text-[#D4AF37] font-['Barlow_Condensed'] mb-1 uppercase">Van Ejecutivo VIP</h4>
          <p class="text-xs text-gray-400 leading-relaxed font-['Barlow_Semi_Condensed']">Vehículos ejecutivos sanitizados de alta gama con espacio de equipaje y aire acondicionado.</p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs font-extrabold text-[#3B6998] uppercase font-['Barlow_Condensed']">Máximo Confort</span>
          <a href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20cotizar%20van%20ejecutiva" class="text-xs font-bold text-[#D4AF37] hover:underline font-['Barlow_Condensed']">Cotizar &rarr;</a>
        </div>
      </div>

      <!-- Bento Item 4 (Wide Horizontal Span 2 Cols) -->
      <div class="md:col-span-2 glass-card text-white rounded-3xl p-8 shadow-xl flex flex-col sm:flex-row items-center gap-6 group hover:border-[#D4AF37]/50 transition-all zoom-image-wrapper">
        <div class="w-full sm:w-1/2 h-44 rounded-2xl overflow-hidden flex-shrink-0 relative">
          <img src="/images/Samana.webp" alt="Excursión a Samaná" class="w-full h-full object-cover" />
        </div>
        <div class="space-y-3">
          <span class="bg-[#3B6998] text-white text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider font-['Barlow_Condensed']">Naturaleza & Cascadas</span>
          <h4 class="text-2xl font-extrabold font-['Barlow_Condensed'] text-[#D4AF37] uppercase">Samaná & Salto del Limón</h4>
          <p class="text-xs text-gray-300 leading-relaxed font-['Barlow_Semi_Condensed']">Explora bosques vírgenes, cabalgatas hacia el salto de agua y paisajes del Atlántico.</p>
          <a href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20información%20del%20tour%20Samaná" class="inline-block bg-[#D4AF37] text-[#050505] font-extrabold text-xs px-5 py-2.5 rounded-full hover:bg-white transition-all font-['Barlow_Condensed'] uppercase tracking-wider">Reservar Tour por WhatsApp</a>
        </div>
      </div>

    </div>
  </section>

  <!-- POR QUE ELEGIRNOS -->
  <section class="py-20 bg-[#050505] text-white border-t border-b border-[#D4AF37]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="bg-[#D4AF37] text-[#050505] text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md">
          Garantía de Servicio
        </span>
        <h2 class="text-4xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] mt-3 text-white uppercase">
          ¿Por qué Elegir TurisRam Dominicana?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {pillars.map(pil => (
          <div class="glass-card p-8 rounded-3xl text-center hover:border-[#D4AF37]/50 transition-all duration-300 group">
            <div class="w-14 h-14 bg-[#D4AF37]/10 border border-[#D4AF37]/30 rounded-2xl flex items-center justify-center mx-auto mb-5 group-hover:bg-[#D4AF37] transition-colors">
              <div class="group-hover:brightness-0 transition-all" set:html={pil.svg} />
            </div>
            <h3 class="text-xl font-extrabold text-[#D4AF37] font-['Barlow_Condensed'] mb-2 uppercase">{pil.title}</h3>
            <p class="text-xs text-gray-300 leading-relaxed font-['Barlow_Semi_Condensed']">{pil.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GOOGLE REVIEWS SECTION -->
  <GoogleReviews />

</Layout>
