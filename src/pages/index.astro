---
import Layout from '../layouts/Layout.astro';
import QuoteModal from '../components/QuoteModal.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

const pillars = [
  { 
    title: "Sin Esperas en Aeropuerto", 
    desc: "Monitoreamos tu vuelo en tiempo real. Tu chofer estará listo con cartel personalizado cuando aterrices.", 
    svg: `<svg class="w-8 h-8 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>` 
  },
  { 
    title: "Tarifa Fija Garantizada", 
    desc: "El precio pactado previamente por WhatsApp es el precio final. Sin cargos ocultos ni sorpresas al llegar.", 
    svg: `<svg class="w-8 h-8 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>` 
  },
  { 
    title: "Choferes Profesionales", 
    desc: "Conductores certificados, bilingües y con amplio conocimiento de todo el país y las principales rutas.", 
    svg: `<svg class="w-8 h-8 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>` 
  },
  { 
    title: "Atención 24/7 por WhatsApp", 
    desc: "Soporte personalizado constante antes, durante y después de tu viaje a cualquier hora del día.", 
    svg: `<svg class="w-8 h-8 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>` 
  }
];

const faqs = [
  {
    q: "¿Cómo funciona la recepción en el aeropuerto con el cartel personalizado?",
    a: "Monitoreamos tu vuelo en tiempo real. Al salir de la terminal (PUJ, SDQ, LRM), tu chofer certificado estará esperándote en la puerta de llegadas sosteniendo un cartel claro con tu nombre completo."
  },
  {
    q: "¿La tarifa cotizada por WhatsApp incluye todos los peajes e impuestos?",
    a: "Sí, 100% garantizado. El precio acordado previamente por WhatsApp es el precio final que pagas. Sin cargos sorpresas por retraso de vuelo, equipaje o peajes."
  },
  {
    q: "¿Qué tipo de vehículos utilizan para los traslados ejecutivos y VIP?",
    a: "Disponemos de vans ejecutivas y SUVs de lujo sanitizadas, equipadas con aire acondicionado de alta potencia, wifi y asientos reclinables de máximo confort."
  },
  {
    q: "¿Con qué anticipación debo reservar mi traslado o excursión?",
    a: "Recomendamos reservar con al menos 24 horas de anticipación. Sin embargo, procesamos cotizaciones exprés por WhatsApp en tiempo real para traslados inmediatos."
  }
];

const tickerItems = [
  "Traslados Aeropuerto PUJ / SDQ / LRM",
  "Tours Privados Isla Saona & Catamarán",
  "Vehículos Ejecutivos VIP Sanitizados",
  "Samaná & Salto del Limón",
  "Monitoreo de Vuelo en Tiempo Real",
  "Asistencia VIP 24/7 por WhatsApp",
  "Excursiones en Santo Domingo & Jarabacoa"
];

// Sets de imagenes para las 3 columnas del carrusel inclinado
const col1Images = [
  "/images/a-black-luxuru-van-c.webp",
  "/images/Isla Saona.webp",
  "/images/create-a-high-quality-image-showing-a-airport--gre.webp",
  "/images/Jarabacoa.webp",
  "/images/Isla Catalina.webp"
];

const col2Images = [
  "/images/Samana.webp",
  "/images/viaja a punta cana.webp",
  "/images/Los Haitises.webp",
  "/images/Conntanza.webp",
  "/images/Bahía de las Águilas.webp"
];

const col3Images = [
  "/images/Santo domingo.webp",
  "/images/Teleférico_de_Puerto_Plata.webp",
  "/images/cabarete.webp",
  "/images/Atardecer_en_La_Romana.webp",
  "/images/generate-an-image-of-a-professional-transportation.webp"
];
---

<Layout title="TurisRam Dominicana | Transfers & Experiencias — Viaja cómodo. Llega seguro.">
  
  <!-- MODULO 2: HERO SECTION CON ESTRUCTURA TOURVEX -->
  <section class="relative min-h-screen bg-[#0A0A0A] text-white overflow-hidden border-b border-[#D4AF37]/20 flex items-center py-12 lg:py-16">
    
    <!-- Imagen de fondo Santo Domingo Noche (.webp) con opacidad 25% -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/santo-domingo-noche.webp"
        alt="Santo Domingo Noche — TurisRam Dominicana"
        class="w-full h-full object-cover object-center animate-subtle-zoom scale-105 opacity-25 mix-blend-luminosity"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A0A] via-[#0A0A0A]/95 to-[#0A0A0A]/85"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-[#3B6998]/20 via-transparent to-[#0A0A0A]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- COLUMNA IZQUIERDA: COPY OFICIAL TURISRAM -->
        <div class="lg:col-span-6 z-20 space-y-6 text-left">
          
          <!-- Live Status Pill -->
          <div class="inline-flex items-center gap-2.5 bg-[#0A0A0A]/90 border border-[#D4AF37]/40 px-4 py-2 rounded-full text-xs font-bold text-[#F7F5F0] backdrop-blur-md font-['Barlow_Condensed'] uppercase tracking-wider shadow-lg">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="text-[#D4AF37]">Choferes VIP Disponibles en Tiempo Real</span>
            <span class="hidden sm:inline text-gray-400">• PUJ, SDQ, LRM</span>
          </div>

          <!-- Tagline Empresa -->
          <span class="block text-xs font-bold uppercase tracking-[0.2em] text-[#3B6998] font-['Barlow_Condensed']">
            TurisRam Dominicana — Transfers & Experiencias
          </span>

          <!-- Título H1 Estilo Tourvex -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold font-['Barlow_Condensed'] tracking-tight leading-[1] text-white uppercase drop-shadow-lg">
            Descubre República Dominicana <br />
            <span class="text-[#D4AF37]">Con Tu Guía VIP</span>
          </h1>

          <!-- Eslogan Oficial -->
          <p class="text-lg sm:text-2xl text-[#D4AF37] font-['Lora'] italic drop-shadow">
            "Viaja cómodo. Llega seguro."
          </p>

          <!-- Párrafo Descriptivo -->
          <p class="text-sm sm:text-base text-gray-200 max-w-xl font-['Barlow_Semi_Condensed'] leading-relaxed drop-shadow">
            Olvídate del estrés en el aeropuerto. Chofer profesional capacitado con cartel personalizado, vehículos de lujo sanitizados y confirmación instantánea por WhatsApp a tarifa fija.
          </p>

          <!-- Acciones CTA -->
          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a
              href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20cotizar%20un%20traslado%20privado"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto butn-arrow hover:scale-105"
            >
              <span>Cotizar por WhatsApp</span>
              <span class="arrow-wrap"><i class="text-[#0A0A0A] font-bold">&rarr;</i></span>
            </a>
            <a
              href="/servicios"
              class="w-full sm:w-auto bg-white/10 backdrop-blur-md border border-white/20 text-white font-bold text-xs uppercase tracking-wider px-8 py-4 rounded-full hover:bg-white/20 transition-all font-['Barlow_Condensed'] text-center"
            >
              Explorar Tours & Servicios
            </a>
          </div>

        </div>

        <!-- COLUMNA DERECHA: CARRUSEL INCLINADO A 6 GRADOS -->
        <div class="lg:col-span-6 relative h-[650px] sm:h-[750px] flex items-center justify-center select-none">
          
          <!-- Contenedor Continuo Inclinado a 6 Grados Exactos -->
          <div class="transform rotate-[6deg] scale-105 flex gap-3 sm:gap-5 justify-center items-start w-full">
            
            <!-- Columna 1 (Izquierda) -->
            <div class="animate-scroll-col1 flex flex-col gap-3 sm:gap-4 flex-shrink-0 hover:[animation-play-state:paused]">
              {[...col1Images, ...col1Images, ...col1Images].map((imgUrl, i) => (
                <div class="w-28 sm:w-36 h-44 sm:h-52 rounded-[2rem] overflow-hidden border border-white/20 shadow-2xl bg-[#0A0A0A] flex-shrink-0 hover:scale-105 transition-transform duration-300 hover:border-[#D4AF37]/80 cursor-pointer">
                  <img src={imgUrl} alt={`TurisRam Destination ${i}`} class="w-full h-full object-cover" />
                </div>
              ))}
            </div>

            <!-- Columna 2 (Centro - 50% MAS LENTA) -->
            <div class="animate-scroll-col2 flex flex-col gap-3 sm:gap-4 flex-shrink-0 -mt-10 hover:[animation-play-state:paused]">
              {[...col2Images, ...col2Images, ...col2Images].map((imgUrl, i) => (
                <div class="w-28 sm:w-36 h-44 sm:h-52 rounded-[2rem] overflow-hidden border border-[#D4AF37]/50 shadow-2xl bg-[#0A0A0A] flex-shrink-0 hover:scale-105 transition-transform duration-300 hover:border-[#D4AF37] cursor-pointer">
                  <img src={imgUrl} alt={`TurisRam Tour ${i}`} class="w-full h-full object-cover" />
                </div>
              ))}
            </div>

            <!-- Columna 3 (Derecha) -->
            <div class="animate-scroll-col3 flex flex-col gap-3 sm:gap-4 flex-shrink-0 hover:[animation-play-state:paused]">
              {[...col3Images, ...col3Images, ...col3Images].map((imgUrl, i) => (
                <div class="w-28 sm:w-36 h-44 sm:h-52 rounded-[2rem] overflow-hidden border border-white/20 shadow-2xl bg-[#0A0A0A] flex-shrink-0 hover:scale-105 transition-transform duration-300 hover:border-[#D4AF37]/80 cursor-pointer">
                  <img src={imgUrl} alt={`TurisRam VIP Transfer ${i}`} class="w-full h-full object-cover" />
                </div>
              ))}
            </div>

          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- TOURVEX TICKER SCROLLING RIBBON -->
  <div class="ticker-wrapper z-30">
    <div class="ticker-content">
      {[...tickerItems, ...tickerItems, ...tickerItems].map((item) => (
        <span class="ticker-item">
          <span class="text-[#D4AF37]">✦</span>
          <span>{item}</span>
        </span>
      ))}
    </div>
  </div>

  <!-- MODULO 3: QUOTE ENGINE WIDGET -->
  <section class="max-w-7xl mx-auto px-4 -mt-6 relative z-20">
    <QuoteModal />
  </section>

  <!-- MODULO 4: CATÁLOGO EXECUTIVE VIP -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    
    <!-- Watermark Typographic Background -->
    <div class="bg-text-style">TurisRam</div>

    <div class="text-center mb-16 relative z-10">
      <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider font-['Barlow_Condensed'] shadow-md">
        Catálogo Executive VIP
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#F7F5F0] font-['Barlow_Condensed'] mt-3 tracking-tight uppercase">
        Servicios & Excursiones Destacadas
      </h2>
      <p class="text-gray-400 mt-2 max-w-2xl mx-auto text-sm font-['Barlow_Semi_Condensed']">
        Descubre nuestra oferta de traslados ejecutivos y tours privados en la República Dominicana.
      </p>

      <!-- Botón Giratorio SVG Nítido y Legible Estilo Tourvex -->
      <div class="mt-8 flex justify-center">
        <a href="#quote-form-v2" class="relative inline-flex items-center justify-center w-36 h-36 sm:w-40 sm:h-40 group">
          <svg class="w-full h-full rotate-circle-svg text-[#D4AF37] fill-current drop-shadow-md" viewBox="0 0 500 500">
            <defs>
              <path id="textcircle-tourvex-v2" d="M250,400 a150,150 0 0,1 0,-300a150,150 0 0,1 0,300Z"></path>
            </defs>
            <text font-size="42" font-weight="900" letter-spacing="6" fill="#D4AF37">
              <textPath href="#textcircle-tourvex-v2" startOffset="0">
                TURISRAM DOMINICANA • COTIZAR AHORA •
              </textPath>
            </text>
          </svg>
          <div class="absolute w-14 h-14 bg-[#D4AF37] border-2 border-white rounded-full flex items-center justify-center text-[#0A0A0A] font-extrabold text-lg shadow-2xl group-hover:bg-white transition-all group-hover:scale-110">
            &darr;
          </div>
        </a>
      </div>
    </div>

    <!-- Grid de Tarjetas Catálogo -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 relative z-10">
      
      <!-- Bento Item 1 (Large Featured - Isla Saona) -->
      <div class="md:col-span-2 md:row-span-2 bg-[#0A0A0A] text-white rounded-3xl overflow-hidden shadow-2xl relative flex flex-col justify-between group border border-[#D4AF37]/30 hover:shadow-[0_20px_50px_rgba(212,175,55,0.28)] hover:border-[#D4AF37]/70 transition-all duration-300 zoom-image-wrapper">
        <div class="absolute inset-0 z-0">
          <img
            src="/images/Isla Saona.webp"
            alt="Tour Isla Saona VIP"
            class="w-full h-full object-cover opacity-60"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/40 to-transparent"></div>
        </div>

        <div class="relative z-10 p-8 flex justify-between items-start">
          <span class="bg-[#D4AF37] text-[#0A0A0A] text-[11px] font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider font-['Barlow_Condensed'] shadow-md">
            Tour Más Popular
          </span>
          <span class="glass-card text-white text-xs font-bold px-3 py-1 rounded-lg font-['Barlow_Condensed']">
            Full Day VIP
          </span>
        </div>

        <div class="relative z-10 p-8">
          <h3 class="text-2xl sm:text-3xl font-extrabold font-['Barlow_Condensed'] mb-2 text-[#D4AF37] uppercase">
            Isla Saona VIP & Piscina Natural
          </h3>
          <p class="text-xs sm:text-sm text-gray-200 leading-relaxed mb-6 max-w-lg font-['Barlow_Semi_Condensed']">
            Navega en catamarán de lujo por aguas cristalinas, disfruta de almuerzo buffet típico frente al mar y nada con estrellas de mar gigantes.
          </p>

          <div class="flex items-center gap-4 pt-4 border-t border-white/20">
            <a
              href="https://wa.me/18497527408?text=¡Hola!%20Me%20interesa%20reservar%20el%20tour%20Isla%20Saona%20VIP"
              target="_blank"
              rel="noopener noreferrer"
              class="butn-arrow"
            >
              <span>Reservar Tour por WhatsApp</span>
              <span class="arrow-wrap"><i class="text-[#0A0A0A] font-bold">&rarr;</i></span>
            </a>
          </div>
        </div>
      </div>

      <!-- Bento Item 2 (Traslado Aeropuerto) -->
      <div class="glass-card rounded-3xl p-6 shadow-lg flex flex-col justify-between group border border-white/10 hover:shadow-[0_20px_50px_rgba(255,255,255,0.18)] hover:border-[#D4AF37]/60 transition-all duration-300 zoom-image-wrapper">
        <div>
          <div class="h-40 rounded-2xl overflow-hidden mb-4 relative">
            <img src="/images/create-a-high-quality-image-showing-a-airport--gre.webp" alt="Traslado Aeropuerto" class="w-full h-full object-cover" />
          </div>
          <h4 class="font-bold text-lg text-[#D4AF37] font-['Barlow_Condensed'] mb-1 uppercase">Traslado Aeropuerto PUJ / SDQ</h4>
          <p class="text-xs text-gray-400 leading-relaxed font-['Barlow_Semi_Condensed']">Monitoreo de vuelo en vivo y chofer esperándote en la puerta con cartel personalizado.</p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
          <span class="text-[11px] font-bold text-[#3B6998] uppercase font-['Barlow_Condensed']">Puntualidad 100%</span>
          <a href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20cotizar%20traslado%20de%20aeropuerto" class="text-xs font-bold text-[#D4AF37] hover:underline font-['Barlow_Condensed']">Cotizar &rarr;</a>
        </div>
      </div>

      <!-- Bento Item 3 (Van Ejecutivo VIP) -->
      <div class="glass-card rounded-3xl p-6 shadow-lg flex flex-col justify-between group border border-white/10 hover:shadow-[0_20px_50px_rgba(212,175,55,0.22)] hover:border-[#D4AF37]/60 transition-all duration-300 zoom-image-wrapper">
        <div>
          <div class="h-40 rounded-2xl overflow-hidden mb-4 relative">
            <img src="/images/generate-an-image-of-a-professional-transportation.webp" alt="Van Ejecutivo VIP TurisRam" class="w-full h-full object-cover" />
          </div>
          <h4 class="font-bold text-lg text-[#D4AF37] font-['Barlow_Condensed'] mb-1 uppercase">Van Ejecutivo VIP</h4>
          <p class="text-xs text-gray-400 leading-relaxed font-['Barlow_Semi_Condensed']">Vehículos ejecutivos sanitizados de alta gama con espacio de equipaje y aire acondicionado.</p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
          <span class="text-[11px] font-bold text-[#3B6998] uppercase font-['Barlow_Condensed']">Máximo Confort</span>
          <a href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20cotizar%20van%20ejecutiva" class="text-xs font-bold text-[#D4AF37] hover:underline font-['Barlow_Condensed']">Cotizar &rarr;</a>
        </div>
      </div>

      <!-- Bento Item 4 (Samaná) -->
      <div class="md:col-span-2 glass-card text-white rounded-3xl p-8 shadow-xl flex flex-col sm:flex-row items-center gap-6 group border border-white/10 hover:shadow-[0_20px_50px_rgba(59,105,152,0.3)] hover:border-[#D4AF37]/60 transition-all duration-300 zoom-image-wrapper">
        <div class="w-full sm:w-1/2 h-44 rounded-2xl overflow-hidden flex-shrink-0 relative">
          <img src="/images/Samana.webp" alt="Excursión a Samaná" class="w-full h-full object-cover" />
        </div>
        <div class="space-y-3">
          <span class="bg-[#3B6998] text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider font-['Barlow_Condensed']">Naturaleza & Cascadas</span>
          <h4 class="text-xl font-bold font-['Barlow_Condensed'] text-[#D4AF37] uppercase">Samaná & Salto del Limón</h4>
          <p class="text-xs text-gray-300 leading-relaxed font-['Barlow_Semi_Condensed']">Explora bosques vírgenes, cabalgatas hacia el salto de agua y paisajes del Atlántico.</p>
          <a href="https://wa.me/18497527408?text=¡Hola!%20Deseo%20información%20del%20tour%20Samaná" class="inline-block bg-[#D4AF37] text-[#0A0A0A] font-bold text-xs px-5 py-2.5 rounded-full hover:bg-white transition-all font-['Barlow_Condensed']">Reservar Tour por WhatsApp</a>
        </div>
      </div>

    </div>
  </section>

  <!-- SECCIÓN BANNER PANORÁMICO ANCHO CON SCROLL SCRUB DIAGONAL & ENCABEZADO EXACTO DE FOTO -->
  <section class="py-16 sm:py-24 max-w-[94rem] mx-auto px-2 sm:px-6 relative z-20" id="scrub-road-section">
    
    <!-- ENCABEZADO OFICIAL SEGÚN REFERENCIA DE FOTO USER: GARANTÍA DE SERVICIO + TÍTULO -->
    <div class="text-center mb-12 relative z-10">
      <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs sm:text-sm font-extrabold px-6 py-2 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-xl inline-block mb-4">
        GARANTÍA DE SERVICIO
      </span>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold font-['Barlow_Condensed'] text-white uppercase tracking-tight leading-none drop-shadow-2xl">
        ¿POR QUÉ ELEGIR TURISRAM DOMINICANA?
      </h2>
    </div>

    <!-- Contenedor Marco Cápsula Panorámico Ampliado (Radius Mask Tourvex Style) -->
    <div class="relative rounded-[3.5rem] sm:rounded-[4.5rem] overflow-hidden border border-[#D4AF37]/40 shadow-2xl bg-[#0A0A0A] p-6 sm:p-14 lg:p-20 text-center text-white">
      
      <!-- Imagen Parallax de Fondo (Carretera/Paisaje Dominicano) -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/create-a-high-quality-image-showing-a-airport--gre.webp"
          alt="Carretera TurisRam Dominicana"
          class="w-full h-full object-cover object-center brightness-75 scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A]/90 via-[#0A0A0A]/40 to-[#0A0A0A]/30"></div>
      </div>

      <!-- Contenido Central del Banner -->
      <div class="relative z-10 max-w-4xl mx-auto space-y-6 mb-16">
        <h3 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold font-['Barlow_Condensed'] text-white uppercase tracking-tight leading-tight drop-shadow-xl">
          Prepárate para explorar y descubrir tu mundo.
        </h3>

        <!-- Botón Giratorio SVG Translúcido con EFECTO MAGNÉTICO al Cursor -->
        <div class="flex justify-center pt-4">
          <div 
            id="magnet-btn"
            class="relative inline-flex items-center justify-center w-40 h-40 sm:w-48 sm:h-48 group cursor-pointer transition-transform duration-300 ease-out"
          >
