---
import Layout from '../layouts/Layout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';

const values = [
  { title: "Puntualidad Monitoreada 24/7", desc: "Rastreamos tu vuelo en tiempo real y coordinamos la llegada del chofer para evitar cualquier tiempo de espera en el aeropuerto." },
  { title: "Seguridad & Flota VIP", desc: "Vehiculos ejecutivos sometidos a rigurosas inspecciones mecanicas periodicas, totalmente asegurados, limpios y climatizados." },
  { title: "Atencion VIP Personalizada", desc: "Trato esmerado, conductores bilingues certificados uniformados y comunicacion constante por WhatsApp antes, durante y despues." },
  { title: "Tarifas Transparentes Garantizadas", desc: "Precios fijos previamente acordados sin cargos ocultos en aeropuertos, peajes ni suplementos sorpresa al abordar." }
];

const faqs = [
  { q: "Como funciona la recepcion en el aeropuerto con el cartel personalizado?", a: "Monitoreamos tu vuelo en tiempo real. Al salir de la terminal (PUJ, SDQ, LRM), tu chofer certificado estara esperandote en la puerta de llegadas sosteniendo un cartel claro con tu nombre completo." },
  { q: "La tarifa cotizada por WhatsApp incluye todos los peajes e impuestos?", a: "Si, 100% garantizado. El precio acordado previamente por WhatsApp es el precio final que pagas. Sin cargos sorpresas por retraso de vuelo, equipaje o peajes." },
  { q: "Que tipo de vehiculos utilizan para los traslados ejecutivos y VIP?", a: "Disponemos de vans ejecutivas y SUVs de lujo sanitizadas, equipadas con aire acondicionado de alta potencia, wifi y asientos reclinables de maximo confort." },
  { q: "Con que anticipacion debo reservar mi traslado o excursion?", a: "Recomendamos reservar con al menos 24 horas de anticipacion. Sin embargo, procesamos cotizaciones expres por WhatsApp en tiempo real para traslados inmediatos." }
];
---

<Layout
  title="Sobre Nosotros | TurisRam Dominicana Transporte VIP"
  description="Conoce la trayectoria, mision y estandares de excelencia de TurisRam Dominicana. Servicio lider en traslados privados y tours en Republica Dominicana."
>

  <!-- HERO -->
  <section class="bg-[#030303] text-white pt-14 pb-0 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#D4AF37]/8 rounded-full blur-3xl pointer-events-none"></div>
    <div data-reveal="fade-up" class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 text-center mb-8">
      <span class="bg-[#D4AF37] text-[#0A0A0A] text-[10px] sm:text-xs font-extrabold px-4 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-3">Nuestra Identidad &amp; Estandares VIP</span>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-['Barlow_Condensed'] tracking-tight leading-tight mb-3 uppercase">Bienvenidos a <span class="text-[#D4AF37]">TurisRam Dominicana</span></h1>
      <p class="text-xs sm:text-sm text-gray-400 max-w-xl mx-auto font-['Barlow_Semi_Condensed'] leading-relaxed">Somos una empresa lider dedicada a brindar experiencias de transporte privado de maxima excelencia, conectando a viajeros con los destinos mas fascinantes de la Republica Dominicana.</p>
    </div>
    <div data-reveal="scale-up" data-delay="0.2" class="relative z-10 w-full px-3 sm:px-5">
      <div class="relative rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden border border-[#D4AF37]/35 shadow-2xl h-[280px] sm:h-[420px] lg:h-[500px] group">
        <img src="/images/create-a-warm-and-professional-header-image-for-th.webp" alt="Chofer profesional TurisRam Dominicana" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 brightness-100" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#030303]/60 via-transparent to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- NUESTRA HISTORIA -->
  <section class="py-24 bg-[#050505] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div data-reveal="fade-right" class="space-y-6">
          <div class="inline-flex items-center gap-2">
            <span class="text-[#D4AF37] text-lg">&#10033;</span>
            <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md">NUESTRA HISTORIA</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] tracking-tight text-white uppercase leading-none">Pasion por Servir al Turista en <span class="text-[#D4AF37]">Republica Dominicana</span></h2>
          <p class="text-xs sm:text-sm text-gray-300 font-['Barlow_Semi_Condensed'] leading-relaxed">TurisRam Dominicana nacio con el proposito firme de elevar los estandares del transporte turistico en todo el pais. Comprendemos perfectamente la importancia del tiempo del viajero tras un vuelo largo y la necesidad de contar con un transporte seguro, comodo y sin sorpresas.</p>
          <p class="text-xs sm:text-sm text-gray-300 font-['Barlow_Semi_Condensed'] leading-relaxed">Desde nuestros inicios en Punta Cana, hemos expandido nuestra cobertura a los 5 aeropuertos principales (Punta Cana PUJ, Santo Domingo SDQ, La Romana LRM, Santiago STI y Puerto Plata POP), convirtiendos en la opcion ejecutiva preferida por familias, parejas y delegaciones de negocios.</p>
        </div>
        <div data-reveal="fade-left" class="relative rounded-3xl overflow-hidden shadow-2xl border border-[#D4AF37]/40 bg-[#141414] group">
          <img src="/images/generate-an-image-of-a-professional-transportation.webp" alt="Flota de vehiculos ejecutivos TurisRam Dominicana" class="w-full h-[420px] object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-transparent to-transparent opacity-80"></div>
          <div class="absolute bottom-6 left-6 right-6 p-4 bg-[#141414]/90 backdrop-blur-md rounded-2xl border border-[#D4AF37]/30">
            <p class="text-xs font-bold text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider">Flota Moderna &amp; Conductores Certificados</p>
            <p class="text-[11px] text-gray-300 font-['Barlow_Semi_Condensed']">Atencion 24/7 en todos los polos turisticos dominicanos.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROPOSITO CORPORATIVO -->
  <section class="relative bg-[#0A0A0A] text-white py-32">
    <div class="absolute top-0 inset-x-0 h-24 bg-gradient-to-b from-[#050505] to-transparent pointer-events-none"></div>
    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#030303] to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal="fade-up" class="text-center mb-16">
        <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-4">PROPOSITO CORPORATIVO</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] uppercase tracking-tight text-white leading-none">Comprometidos con Tu <span class="text-[#D4AF37]">Tranquilidad &amp; Confort</span></h2>
      </div>
      <div data-reveal="stagger" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div data-reveal-item class="bg-[#141409] border border-[#D4AF37]/15 p-8 sm:p-10 rounded-2xl hover:border-[#D4AF37]/40 transition-all duration-300 shadow-xl group hover:shadow-[0_8px_40px_rgba(212,175,55,0.08)]">
          <div class="w-12 h-12 bg-[#D4AF37]/15 border border-[#D4AF37]/30 text-[#D4AF37] rounded-xl flex items-center justify-center mb-7 group-hover:bg-[#D4AF37]/25 transition-colors duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white font-['Barlow_Condensed'] uppercase tracking-wider mb-4">Nuestra Mision</h3>
          <p class="text-sm text-gray-400 font-['Barlow_Semi_Condensed'] leading-relaxed">Proporcionar un servicio de transporte turistico puntual, seguro y altamente confortable en Republica Dominicana, garantizando tarifas transparentes sin cobros ocultos y una atencion VIP personalizada que supere las expectativas de cada viajero.</p>
        </div>
        <div data-reveal-item class="bg-[#141409] border border-[#D4AF37]/15 p-8 sm:p-10 rounded-2xl hover:border-[#D4AF37]/40 transition-all duration-300 shadow-xl group hover:shadow-[0_8px_40px_rgba(212,175,55,0.08)]">
          <div class="w-12 h-12 bg-[#D4AF37]/15 border border-[#D4AF37]/30 text-[#D4AF37] rounded-xl flex items-center justify-center mb-7 group-hover:bg-[#D4AF37]/25 transition-colors duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white font-['Barlow_Condensed'] uppercase tracking-wider mb-4">Nuestra Vision</h3>
          <p class="text-sm text-gray-400 font-['Barlow_Semi_Condensed'] leading-relaxed">Ser la empresa de traslados privados y tours ejecutivos mas confiable, recomendada y prestigiada en la Republica Dominicana, distinguida por nuestra puntualidad impecable, flota moderna y compromiso absoluto con la satisfaccion de nuestros pasajeros.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FILOSOFIA & EXCELENCIA -->
  <section class="py-24 bg-[#030303] text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal="fade-up" class="text-center mb-14">
        <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-3">FILOSOFIA &amp; EXCELENCIA</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] uppercase tracking-tight text-white leading-none">Los Pilares de <span class="text-[#D4AF37]">Nuestro Servicio VIP</span></h2>
      </div>
      <div data-reveal="stagger" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {values.map(v => (
          <div data-reveal-item class="bg-[#141409] border border-[#D4AF37]/15 p-7 rounded-2xl hover:border-[#D4AF37]/40 transition-all duration-300 shadow-xl group hover:shadow-[0_8px_40px_rgba(212,175,55,0.08)]">
            <div class="w-12 h-12 bg-[#D4AF37]/15 border border-[#D4AF37]/30 text-[#D4AF37] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#D4AF37]/25 transition-colors duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h3 class="text-sm font-bold text-white font-['Barlow_Condensed'] uppercase tracking-wider mb-2">{v.title}</h3>
            <p class="text-xs text-gray-400 font-['Barlow_Semi_Condensed'] leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXPERIENCIAS REALES -->
  <TestimonialsSection />

  <!-- PREGUNTAS FRECUENTES -->
  <section class="py-24 bg-[#050505] text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div data-reveal="fade-right" class="lg:col-span-5 hidden lg:flex gap-6 items-center justify-center">
          <div class="w-48 h-80 rounded-[2.5rem] overflow-hidden border border-white/20 shadow-2xl">
            <img src="/images/create-a-high-quality-image-showing-a-airport--gre.webp" alt="FAQ TurisRam" class="w-full h-full object-cover" />
          </div>
          <div class="w-48 h-80 rounded-[2.5rem] overflow-hidden border border-[#D4AF37]/40 shadow-2xl mt-16">
            <img src="/images/generate-an-image-of-a-professional-transportation.webp" alt="FAQ TurisRam Van" class="w-full h-full object-cover" />
          </div>
        </div>
        <div data-reveal="fade-left" class="lg:col-span-7 space-y-6">
          <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs sm:text-sm font-extrabold px-5 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block">PREGUNTAS FRECUENTES</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-['Barlow_Condensed'] mt-2 text-white uppercase">Resolvemos Tus Dudas Al Instante</h2>
          <div data-reveal="stagger" class="space-y-4">
            {faqs.map((faq) => (
              <details data-reveal-item class="bg-[#141409] border border-[#D4AF37]/15 rounded-2xl p-6 group cursor-pointer transition-all hover:border-[#D4AF37]/35">
                <summary class="font-bold text-base text-[#D4AF37] font-['Barlow_Condensed'] uppercase flex items-center justify-between list-none">
                  <span>{faq.q}</span>
                  <span class="text-[#D4AF37] text-xl ml-4 flex-shrink-0">+</span>
                </summary>
                <p class="text-xs text-gray-300 leading-relaxed font-['Barlow_Semi_Condensed'] mt-3 pt-3 border-t border-white/10">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="relative py-28 bg-[#030303] text-white text-center overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[600px] h-[300px] bg-[#D4AF37]/8 rounded-full blur-[80px]"></div>
    </div>
    <div data-reveal="scale-up" class="relative z-10 max-w-3xl mx-auto px-6">
      <div class="border border-[#D4AF37]/25 rounded-3xl p-12 sm:p-16 bg-[#0A0A0A]/60 backdrop-blur-sm shadow-2xl">
        <span class="bg-[#D4AF37] text-[#0A0A0A] text-[10px] sm:text-xs font-extrabold px-4 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-5">RESERVA TU TRASLADO VIP</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] uppercase leading-tight mb-4">Listo para Planificar<br/><span class="text-[#D4AF37]">Tu Proximo Traslado?</span></h2>
        <p class="text-xs sm:text-sm text-gray-400 font-['Barlow_Semi_Condensed'] mb-10 max-w-lg mx-auto leading-relaxed">Cotiza tu transporte privado en segundos. Chofer bilingue certificado esperandote a tu llegada con cartel personalizado.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://wa.me/18497527408?text=Hola!%20Deseo%20hacer%20una%20reserva%20de%20transporte%20con%20TurisRam" target="_blank" rel="noopener noreferrer" class="butn-arrow hover:scale-105 inline-flex">
            <span>Cotizar por WhatsApp</span>
            <span class="arrow-wrap"><i class="text-[#0A0A0A] font-bold">&rarr;</i></span>
          </a>
          <a href="/servicios" class="text-xs font-bold text-[#D4AF37] hover:text-white font-['Barlow_Condensed'] uppercase tracking-widest border border-[#D4AF37]/30 hover:border-[#D4AF37] px-6 py-3 rounded-full transition-all duration-300">Ver Todos los Servicios</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
