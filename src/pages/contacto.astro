---
import Layout from '../layouts/Layout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';

const googleMapsLink = "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r";
---

<Layout
  title="Contacto y Reservas | TurisRan Dominicana Transporte VIP"
  description="Ponte en contacto con TurisRan Dominicana. Escríbenos directamente por WhatsApp al +1 (849) 752-7408 o completa el formulario para cotizar tu traslado."
>

  <!-- HERO SECTION CONTACTO - COPY SUPERIOR + IMAGEN PANORÁMICA FULL-WIDTH -->
  <section class="bg-[#030303] text-white pt-14 pb-0 relative overflow-hidden">
    
    <!-- Glowing Orb -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#D4AF37]/8 rounded-full blur-3xl pointer-events-none"></div>

    <!-- 1. COPY SUPERIOR ELEGANTE Y COMPACTO -->
    <div data-reveal="fade-up" class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 text-center mb-8">
      <span class="bg-[#D4AF37] text-[#0A0A0A] text-[10px] sm:text-xs font-extrabold px-4 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-3">
        Estamos a tu Servicio 24/7
      </span>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-['Barlow_Condensed'] tracking-tight leading-tight mb-3 uppercase">
        Contáctanos <span class="text-[#D4AF37]">Hoy Mismo</span>
      </h1>
      <p class="text-xs sm:text-sm text-gray-400 max-w-xl mx-auto font-['Barlow_Semi_Condensed'] leading-relaxed">
        Respuesta rápida e inmediata las 24 horas del día, los 7 días de la semana por WhatsApp y teléfono.
      </p>
    </div>

    <!-- 2. IMAGEN PANORÁMICA FULL-WIDTH -->
    <div data-reveal="scale-up" data-delay="0.2" class="relative z-10 w-full px-3 sm:px-5">
      <div class="relative rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden border border-[#D4AF37]/35 shadow-2xl h-[280px] sm:h-[420px] lg:h-[500px] group">
        <img
          src="/images/create-a-clean-and-inviting-image-for-a--contact-u.webp"
          alt="Contacto TurisRan Dominicana"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 brightness-100"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#030303]/60 via-transparent to-transparent"></div>
      </div>
    </div>

  </section>

  <!-- SECCIÓN DE CONTACTO INFO + FORMULARIO CON DISEÑO VIP -->
  <section class="py-20 bg-[#050505] text-[#F7F5F0] border-b border-[#D4AF37]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        
        <!-- Información de Contacto Directo -->
        <div data-reveal="fade-right" class="space-y-8">
          <div>
            <div class="inline-flex items-center gap-2 mb-2">
              <span class="text-[#D4AF37] animate-spin text-lg">✱</span>
              <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md">
                ATENCIÓN AL CLIENTE
              </span>
            </div>
            <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] uppercase tracking-tight text-white leading-none">
              Información Directa de <span class="text-[#D4AF37]">Contacto</span>
            </h2>
            <p class="text-xs sm:text-sm text-gray-300 mt-3 font-['Barlow_Semi_Condensed'] leading-relaxed">
              Puedes comunicarte directamente con nuestro equipo de atención VIP vía WhatsApp, llamada telefónica o explorando nuestra ubicación oficial en Google Maps.
            </p>
          </div>

          <div class="space-y-6">
            
            <!-- Item 1: WA / Teléfono -->
            <div class="flex items-start gap-4 p-6 bg-[#141414] border border-[#D4AF37]/30 rounded-3xl shadow-xl hover:border-[#D4AF37] transition-all">
              <div class="w-12 h-12 bg-[#D4AF37] text-[#0A0A0A] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider text-base">WhatsApp & Teléfono VIP</h4>
                <p class="text-xs text-gray-400 font-['Barlow_Semi_Condensed'] mb-1">Atención personalizada las 24 Horas en español e inglés.</p>
                <a href="https://wa.me/18497527408" class="text-sm font-bold text-white hover:text-[#D4AF37] transition-colors font-['Barlow_Condensed'] tracking-wider">
                  +1 (849) 752-7408
                </a>
              </div>
            </div>

            <!-- Item 1.5: Correo Corporativo -->
            <div class="flex items-start gap-4 p-6 bg-[#141414] border border-[#D4AF37]/30 rounded-3xl shadow-xl hover:border-[#D4AF37] transition-all">
              <div class="w-12 h-12 bg-[#D4AF37] text-[#0A0A0A] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider text-base">Correo Corporativo</h4>
                <p class="text-xs text-gray-400 font-['Barlow_Semi_Condensed'] mb-1">Cotizaciones para agencias, empresas y solicitudes formales.</p>
                <a href="mailto:info@turisran-dominicana.com" class="text-sm font-bold text-white hover:text-[#D4AF37] transition-colors font-['Barlow_Condensed'] tracking-wider">
                  info@turisran-dominicana.com
                </a>
              </div>
            </div>

            <!-- Item 2: Cobertura -->
            <div class="flex items-start gap-4 p-6 bg-[#141414] border border-[#D4AF37]/30 rounded-3xl shadow-xl hover:border-[#D4AF37] transition-all">
              <div class="w-12 h-12 bg-[#D4AF37] text-[#0A0A0A] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider text-base">Cobertura en 5 Aeropuertos</h4>
                <p class="text-xs text-gray-400 font-['Barlow_Semi_Condensed'] mb-1">Punta Cana (PUJ), Santo Domingo (SDQ), La Romana (LRM), Santiago (STI), Puerto Plata (POP).</p>
                <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#D4AF37] underline font-['Barlow_Condensed'] uppercase tracking-wider">
                  Ver en Google Maps &rarr;
                </a>
              </div>
            </div>

            <!-- Item 3: Horarios -->
            <div class="flex items-start gap-4 p-6 bg-[#141414] border border-[#D4AF37]/30 rounded-3xl shadow-xl hover:border-[#D4AF37] transition-all">
              <div class="w-12 h-12 bg-[#D4AF37] text-[#0A0A0A] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
              </div>
              <div>
                <h4 class="font-bold text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider text-base">Horarios de Operación</h4>
                <p class="text-xs text-gray-300 font-['Barlow_Semi_Condensed']">Servicio de chofer y reservas disponible 24 Horas / 7 Días / 365 días del año.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Formulario de Contacto en Contenedor Oscuro VIP -->
        <div data-reveal="fade-left" class="bg-[#141414] border border-[#D4AF37]/30 p-8 sm:p-10 rounded-3xl shadow-2xl">
          <h3 class="text-2xl font-bold text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider mb-1">Envíanos un Mensaje Directo</h3>
          <p class="text-xs text-gray-400 font-['Barlow_Semi_Condensed'] mb-6">Completa tus datos y nos pondremos en contacto contigo de inmediato vía WhatsApp.</p>

          <form id="contact-form" class="space-y-4">
            <div>
              <label class="block text-xs font-extrabold text-[#D4AF37] uppercase tracking-wider mb-1 font-['Barlow_Condensed']">Nombre Completo</label>
              <input 
                type="text" 
                id="contact-name" 
                required 
                placeholder="Ej. Juan Pérez" 
                class="w-full bg-[#050505] border border-[#D4AF37]/30 text-white rounded-2xl px-4 py-3.5 text-xs focus:outline-none focus:border-[#D4AF37] focus:ring-2 focus:ring-[#D4AF37]/30 font-['Barlow_Semi_Condensed'] transition-all" 
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-extrabold text-[#D4AF37] uppercase tracking-wider mb-1 font-['Barlow_Condensed']">Teléfono / WhatsApp</label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  required 
                  placeholder="+1 849..." 
                  class="w-full bg-[#050505] border border-[#D4AF37]/30 text-white rounded-2xl px-4 py-3.5 text-xs focus:outline-none focus:border-[#D4AF37] focus:ring-2 focus:ring-[#D4AF37]/30 font-['Barlow_Semi_Condensed'] transition-all" 
                />
              </div>
              <div>
                <label class="block text-xs font-extrabold text-[#D4AF37] uppercase tracking-wider mb-1 font-['Barlow_Condensed']">Correo Electrónico</label>
                <input 
                  type="email" 
                  id="contact-email" 
                  required 
                  placeholder="correo@ejemplo.com" 
                  class="w-full bg-[#050505] border border-[#D4AF37]/30 text-white rounded-2xl px-4 py-3.5 text-xs focus:outline-none focus:border-[#D4AF37] focus:ring-2 focus:ring-[#D4AF37]/30 font-['Barlow_Semi_Condensed'] transition-all" 
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-extrabold text-[#D4AF37] uppercase tracking-wider mb-1 font-['Barlow_Condensed']">Mensaje o Detalle del Traslado</label>
              <textarea 
                id="contact-message" 
                rows="4" 
                required 
                placeholder="Detalla tu lugar de origen, destino, número de personas y fechas de viaje..." 
                class="w-full bg-[#050505] border border-[#D4AF37]/30 text-white rounded-2xl px-4 py-3.5 text-xs focus:outline-none focus:border-[#D4AF37] focus:ring-2 focus:ring-[#D4AF37]/30 font-['Barlow_Semi_Condensed'] transition-all"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-[#D4AF37] text-[#0A0A0A] font-extrabold text-xs uppercase tracking-wider py-4 rounded-2xl hover:bg-white hover:scale-[1.02] transition-all font-['Barlow_Condensed'] shadow-xl border border-white/20"
            >
              Enviar Consulta por WhatsApp &rarr;
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- RESEÑAS VERIFICADAS STICKY STACKING -->
  <TestimonialsSection />

  <script is:inline>
    document.getElementById('contact-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const name = document.getElementById('contact-name').value;
      const phone = document.getElementById('contact-phone').value;
      const email = document.getElementById('contact-email').value;
      const msg = document.getElementById('contact-message').value;

      const text = `¡Hola TurisRan Dominicana! Nueva consulta desde la página de contacto:%0A• Nombre: ${name}%0A• Teléfono: ${phone}%0A• Email: ${email}%0A• Mensaje: ${msg}`;
      window.open(`https://wa.me/18497527408?text=${text}`, '_blank');
    });
  </script>

</Layout>
