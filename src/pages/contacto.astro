---
import Layout from '../layouts/Layout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

const googleMapsLink = "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r";
---

<Layout
  title="Contacto y Reservas | TurisRam Dominican Transporte Turístico"
  description="Ponte en contacto con TurisRam Dominican. Escríbenos directamente por WhatsApp al +1 (849) 752-7408 o completa el formulario para cotizar tu traslado."
>

  <!-- HERO SECTION MINI -->
  <section class="relative min-h-[50vh] flex items-center justify-center bg-[#030303] text-white overflow-hidden border-b border-white/10">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/create-a-clean-and-inviting-image-for-a--contact-u.png"
        alt="Contacto TurisRam Dominican"
        class="w-full h-full object-cover opacity-40 animate-subtle-zoom"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#030303] via-[#123458]/75 to-[#030303]/85"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center py-16">
      <span class="inline-block bg-[#D4C9BE] text-[#123458] font-bold text-xs px-4 py-1.5 rounded-full uppercase tracking-widest mb-3 font-['Montserrat'] shadow-md">
        Estamos a Tu Servicio 24/7
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-['Montserrat'] text-white">
        Contáctanos Hoy Mismo
      </h1>
      <p class="text-sm sm:text-base text-gray-300 mt-2 max-w-xl mx-auto">
        Respuesta rápida e inmediata las 24 horas del día, los 7 días de la semana.
      </p>
    </div>
  </section>

  <!-- SECCION DE CONTACTO INFO + FORMULARIO -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      
      <!-- Informacion de Contacto Directo -->
      <div class="space-y-8">
        <div>
          <span class="text-[#123458] font-bold text-xs uppercase tracking-widest font-['Montserrat']">Atención al Cliente</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#123458] font-['Montserrat'] mt-1">
            Información Directa de Contacto
          </h2>
          <p class="text-sm text-gray-600 mt-2">
            Puedes comunicarte directamente con nosotros vía WhatsApp, llamada o visitando nuestra ficha oficial en Google Maps.
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4 p-6 bg-white rounded-3xl shadow-lg border border-gray-100">
            <div class="w-12 h-12 bg-[#123458] text-[#D4C9BE] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-[#123458] font-['Montserrat'] text-base">WhatsApp & Teléfono</h4>
              <p class="text-xs text-gray-500 mb-1">Atención rápida en español y en inglés.</p>
              <a href="https://wa.me/18497527408" class="text-sm font-bold text-[#123458] hover:text-[#D4C9BE]">
                +1 (849) 752-7408
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-6 bg-white rounded-3xl shadow-lg border border-gray-100">
            <div class="w-12 h-12 bg-[#123458] text-[#D4C9BE] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-[#123458] font-['Montserrat'] text-base">Cobertura Nacional</h4>
              <p class="text-xs text-gray-500 mb-1">Punta Cana, Santo Domingo, La Romana, Samaná, Santiago, Puerto Plata.</p>
              <a href={googleMapsLink} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#123458] underline">
                Ver en Google Maps &rarr;
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-6 bg-white rounded-3xl shadow-lg border border-gray-100">
            <div class="w-12 h-12 bg-[#123458] text-[#D4C9BE] rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            </div>
            <div>
              <h4 class="font-bold text-[#123458] font-['Montserrat'] text-base">Horarios de Operación</h4>
              <p class="text-xs text-gray-600">Servicio de traslado disponible las 24 Horas / 365 días del año.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario de Contacto -->
      <div class="bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-gray-100">
        <h3 class="text-2xl font-bold text-[#123458] font-['Montserrat'] mb-2">Envíanos un Mensaje</h3>
        <p class="text-xs text-gray-500 mb-6">Completa tus datos y nos pondremos en contacto contigo de inmediato.</p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-[#123458] uppercase mb-1 font-['Montserrat']">Nombre Completo</label>
            <input type="text" id="contact-name" required placeholder="Ej. Juan Pérez" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3.5 text-sm focus:outline-none focus:border-[#123458]" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-[#123458] uppercase mb-1 font-['Montserrat']">Teléfono / WhatsApp</label>
              <input type="tel" id="contact-phone" required placeholder="+1 849..." class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3.5 text-sm focus:outline-none focus:border-[#123458]" />
            </div>
            <div>
              <label class="block text-xs font-bold text-[#123458] uppercase mb-1 font-['Montserrat']">Correo Electrónico</label>
              <input type="email" id="contact-email" required placeholder="correo@ejemplo.com" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3.5 text-sm focus:outline-none focus:border-[#123458]" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-[#123458] uppercase mb-1 font-['Montserrat']">Mensaje o Detalle del Traslado</label>
            <textarea id="contact-message" rows="4" required placeholder="Detalla tu lugar de origen, destino, número de personas y fechas de viaje..." class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-4 py-3.5 text-sm focus:outline-none focus:border-[#123458]"></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-[#123458] text-[#F1EFEC] font-bold text-xs uppercase tracking-wider py-4 rounded-2xl hover:bg-[#030303] transition-all font-['Montserrat'] shadow-lg border border-white/10"
          >
            Enviar Consulta por WhatsApp
          </button>
        </form>
      </div>

    </div>
  </section>

  <!-- GOOGLE REVIEWS -->
  <GoogleReviews />

  <script is:inline>
    document.getElementById('contact-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const name = document.getElementById('contact-name').value;
      const phone = document.getElementById('contact-phone').value;
      const email = document.getElementById('contact-email').value;
      const msg = document.getElementById('contact-message').value;

      const text = `¡Hola TurisRam Dominican! Nueva consulta desde el formulario de contacto:%0A• Nombre: ${name}%0A• Teléfono: ${phone}%0A• Email: ${email}%0A• Mensaje: ${msg}`;
      window.open(`https://wa.me/18497527408?text=${text}`, '_blank');
    });
  </script>

</Layout>
