---
import Layout from '../layouts/Layout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';

const tours = [
  {
    name: "Isla Saona VIP & Catamarán",
    desc: "Navega en catamarán por aguas turquesas, visita la piscina natural de las estrellas de mar y disfruta de un almuerzo buffet típico frente al Caribe.",
    image: "/images/Isla Saona.webp",
    location: "La Romana / Bayahíbe",
    duration: "Día Completo",
    badge: "Más Popular"
  },
  {
    name: "Bávaro & Playas de Punta Cana",
    desc: "Recorre las mejores playas de arena blanca y aguas cristalinas del Caribe con transporte privado climatizado y atención VIP.",
    image: "/images/viaja a punta cana.webp",
    location: "Punta Cana",
    duration: "4 - 8 Horas",
    badge: "Recomendado"
  },
  {
    name: "Samaná & Salto del Limón",
    desc: "Descubre la península de Samaná, caminatas a cascadas vírgenes de montaña y paisajes paradisíacos rodeados de palmeras.",
    image: "/images/Samana.webp",
    location: "Samaná",
    duration: "Día Completo",
    badge: "Aventura Eco"
  },
  {
    name: "Parque Nacional Los Haitises",
    desc: "Explora místicas cuevas con arte rupestre taíno, manglares vírgenes y mogotes rocosos en una aventura ecológica inolvidable.",
    image: "/images/Los Haitises.webp",
    location: "Sabana de la Mar",
    duration: "Full Day Tour",
    badge: "Cultura & Naturaleza"
  },
  {
    name: "Jarabacoa — Primavera de Montaña",
    desc: "Ríos helados, rafting de nivel internacional, senderos de pino y la majestuosidad de la Cordillera Central dominicana.",
    image: "/images/Jarabacoa.webp",
    location: "Jarabacoa",
    duration: "Full Day",
    badge: "Montaña"
  },
  {
    name: "Constanza & Valle Nuevo",
    desc: "El punto más elevado de las Antillas con clima fresco de montaña, pinares frondosos y saltos de agua espectaculares.",
    image: "/images/Conntanza.webp",
    location: "Constanza",
    duration: "Full Day Tour",
    badge: "Clima Fresco"
  },
  {
    name: "Bahía de las Águilas & Barahona",
    desc: "Conoce la playa más virgen y cristalina de la República Dominicana en el suroeste profundo del país.",
    image: "/images/Bahía de las Águilas.webp",
    location: "Pedernales / Barahona",
    duration: "Excursión VIP",
    badge: "Virgen"
  },
  {
    name: "Teleférico de Puerto Plata",
    desc: "Ascenso panorámico a la cima de la montaña Isabel de Torres con vistas espectaculares sobre la Costa del Ámbar.",
    image: "/images/Teleférico_de_Puerto_Plata.webp",
    location: "Puerto Plata",
    duration: "Medio Día",
    badge: "Vistas 360"
  },
  {
    name: "Isla Catalina Snorkel & Arrecifes",
    desc: "Un paraíso de buceo y snorkel con arrecifes de coral vivos en una isla desierta caribeña cristalina.",
    image: "/images/Isla Catalina.webp",
    location: "La Romana",
    duration: "Día Completo",
    badge: "Snorkel VIP"
  },
  {
    name: "Santo Domingo Zona Colonial",
    desc: "Recorrido por la Primada de América: Alcázar de Colón, Catedral Santa María y la primera calle del Nuevo Mundo.",
    image: "/images/Santo domingo.webp",
    location: "Santo Domingo",
    duration: "Full Day",
    badge: "Histórico"
  },
  {
    name: "Atardecer & Marina La Romana",
    desc: "Paseo exclusivo en la costa este con cena frente a los megayates y puestas de sol memorables en la marina.",
    image: "/images/Atardecer_en_La_Romana.webp",
    location: "La Romana",
    duration: "Tarde / Noche",
    badge: "Exclusivo"
  },
  {
    name: "Cabarete & Deportes Acuáticos",
    desc: "La capital mundial del kitesurf y windsurf en el Caribe con un ambiente vibrante y gastronomía de playa.",
    image: "/images/cabarete.webp",
    location: "Puerto Plata",
    duration: "Full Day",
    badge: "Kitesurf"
  }
];

const faqs = [
  {
    q: "¿Cómo localizo a mi chofer en el aeropuerto a mi llegada?",
    a: "Tu chofer te estará esperando justo a la salida de la terminal de equipajes portando un cartel claramente visible con tu nombre completo y el logo oficial de TurisRan Dominicana."
  },
  {
    q: "¿Qué sucede si mi vuelo se retrasa o cambia de horario?",
    a: "No te preocupes. Monitoreamos todos los vuelos en tiempo real mediante el número de vuelo proporcionado. Tu vehículo estará listo a tu llegada sin recargos adicionales."
  },
  {
    q: "¿El precio indicado es por persona o por vehículo privado?",
    a: "Todos nuestros traslados son privados y tienen una tarifa fija por vehículo (Van VIP o Minibús), lo que significa que el costo no aumenta por pasajero dentro de la capacidad contratada."
  },
  {
    q: "¿Cuáles son los métodos de pago aceptados?",
    a: "Aceptamos pago en efectivo (USD, DOP, EUR) directamente al chofer al abordar, o mediante transferencia bancaria previa previa confirmación."
  }
];
---

<Layout
  title="Servicios y Tours en República Dominicana | TurisRan Dominicana"
  description="Catálogo de traslados privados desde aeropuertos (PUJ, SDQ, STI, LRM) y tours exclusivos en Punta Cana, Saona, Samaná, Santo Domingo y más."
>

  <!-- HERO SECTION SERVICIOS - COPY SUPERIOR + IMAGEN PANORÁMICA FULL-WIDTH -->
  <section class="bg-[#030303] text-white pt-14 pb-0 relative overflow-hidden">
    
    <!-- Glowing Orbs -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#D4AF37]/8 rounded-full blur-3xl pointer-events-none"></div>

    <!-- 1. COPY SUPERIOR ELEGANTE Y COMPACTO -->
    <div data-reveal="fade-up" class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 text-center mb-8">
      <span class="bg-[#D4AF37] text-[#0A0A0A] text-[10px] sm:text-xs font-extrabold px-4 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-3">
        Traslados & Excursiones VIP
      </span>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-['Barlow_Condensed'] tracking-tight leading-tight mb-3 uppercase">
        Nuestros Servicios & <span class="text-[#D4AF37]">Tours Destacados</span>
      </h1>
      <p class="text-xs sm:text-sm text-gray-400 max-w-xl mx-auto font-['Barlow_Semi_Condensed'] leading-relaxed">
        Viaja por toda la República Dominicana con total libertad, confort y la garantía de un servicio profesional a tarifa fija previamente acordada.
      </p>
    </div>

    <!-- 2. IMAGEN PANORÁMICA FULL-WIDTH SIN BORDES NEGROS ANCHOS -->
    <div data-reveal="scale-up" data-delay="0.2" class="relative z-10 w-full px-3 sm:px-5">
      <div class="relative rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden border border-[#D4AF37]/35 shadow-2xl h-[280px] sm:h-[420px] lg:h-[500px] group">
        <img
          src="/images/create-a-breathtaking-landscape-image-that-showcas.webp"
          alt="Paisajes y Tours de República Dominicana TurisRan"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 brightness-100"
        />
        <!-- Overlay degradado sutil inferior -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#030303]/60 via-transparent to-transparent"></div>
      </div>
    </div>

  </section>

  <!-- CATÁLOGO DE TOURS BENTO GRID CON TARJETAS OSCURAS Y BORDES DORADOS -->
  <section class="py-20 bg-[#050505] text-[#F7F5F0] border-b border-[#D4AF37]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div data-reveal="fade-up" class="text-center mb-14">
        <div class="inline-flex items-center gap-2 mb-2">
          <span class="text-[#D4AF37] animate-spin text-lg">✱</span>
          <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md">
            CATÁLOGO DE DESTINOS
          </span>
        </div>

        <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] uppercase tracking-tight text-white leading-none">
          Explora Los Mejores <span class="text-[#D4AF37]">Tours de la Isla</span>
        </h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-3 max-w-2xl mx-auto font-['Barlow_Semi_Condensed']">
          Tours privados adaptados a tu propio ritmo e itinerario. Haz clic en el botón para reservar directamente por WhatsApp con atención inmediata 24/7.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {tours.map((t, idx) => {
          const msg = encodeURIComponent(`¡Hola TurisRan Dominicana! Me gustaría solicitar información y cotización del tour a: ${t.name}`);
          const waLink = `https://wa.me/18497527408?text=${msg}`;
          return (
            <div 
              data-reveal="fade-up" 
              data-duration="1.1" 
              data-distance="40" 
              data-delay={0.1 + (idx % 4) * 0.12} 
              data-ease="power3.out"
              class="bg-[#141414] border border-[#D4AF37]/30 rounded-3xl overflow-hidden shadow-xl flex flex-col justify-between hover:border-[#D4AF37] transition-colors duration-300 group"
            >
              <div>
                <div class="relative h-52 overflow-hidden">
                  <img
                    src={t.image}
                    alt={t.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-transparent to-transparent opacity-60"></div>
                  
                  <div class="absolute top-3 left-3 bg-[#D4AF37] text-[#0A0A0A] text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider font-['Barlow_Condensed'] shadow-md">
                    {t.badge}
                  </div>
                  <div class="absolute bottom-3 left-3 bg-[#030303]/80 text-[#D4AF37] text-[11px] font-bold px-2.5 py-1 rounded-lg backdrop-blur-md font-['Barlow_Condensed'] flex items-center gap-1">
                    <svg class="w-3 h-3 fill-current text-[#D4AF37]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    {t.location}
                  </div>
                </div>

                <div class="p-6">
                  <h3 class="text-lg font-bold text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider mb-2">{t.name}</h3>
                  <p class="text-xs text-gray-300 font-['Barlow_Semi_Condensed'] leading-relaxed mb-4">{t.desc}</p>
                </div>
              </div>

              <div class="p-6 pt-0">
                <a
                  href={waLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full text-center bg-[#D4AF37] text-[#0A0A0A] font-extrabold text-xs uppercase tracking-wider py-3 rounded-xl hover:bg-white hover:scale-[1.02] transition-all font-['Barlow_Condensed'] shadow-md border border-white/20"
                >
                  Reservar Tour por WhatsApp &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- FAQS SECCIÓN ACCORDEON CON ESTILO OSCURO -->
  <section class="py-20 bg-[#0A0A0A] text-white border-b border-[#D4AF37]/20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <div data-reveal="fade-up" class="text-center mb-12">
        <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-3">
          RESUELVE TUS DUDAS
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] uppercase tracking-tight text-white leading-none">
          Preguntas Frecuentes <span class="text-[#D4AF37]">(FAQ)</span>
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((f, i) => (
          <details 
            data-reveal="fade-up" 
            data-duration="1.1" 
            data-distance="40" 
            data-delay={0.15 + i * 0.12} 
            data-ease="power3.out"
            class="bg-[#141414] border border-[#D4AF37]/30 rounded-2xl p-6 group transition-colors duration-300 hover:border-[#D4AF37] shadow-xl"
          >
            <summary class="font-bold text-sm sm:text-base text-[#D4AF37] font-['Barlow_Condensed'] uppercase tracking-wider cursor-pointer flex items-center justify-between list-none">
              <span>{f.q}</span>
              <span class="text-xl transition-transform group-open:rotate-180 text-[#D4AF37]">+</span>
            </summary>
            <p class="text-xs sm:text-sm text-gray-300 font-['Barlow_Semi_Condensed'] mt-3 leading-relaxed border-t border-white/10 pt-3">
              {f.a}
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- RESEÑAS VERIFICADAS STICKY STACKING -->
  <TestimonialsSection />

</Layout>
