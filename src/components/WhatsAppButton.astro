---
const phone = "18497527408";
const defaultMessage = encodeURIComponent("¡Hola TurisRam Dominicana! Me gustaría cotizar un servicio de transporte / tour.");
const whatsappUrl = `https://wa.me/${phone}?text=${defaultMessage}`;
---

<!-- BOTON CIRCULAR OFICIAL WHATSAPP CON ANIMACIÓN DE ENTRADA (3s DELAY) & HOVER PUULSE -->
<div class="fixed bottom-6 right-6 z-50 pointer-events-auto">
  
  <!-- Tooltip sutil en hover -->
  <div class="absolute right-full top-1/2 -translate-y-1/2 mr-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none whitespace-nowrap bg-[#0A0A0A] border border-[#D4AF37]/40 text-[#F7F5F0] text-xs font-bold px-3 py-1.5 rounded-lg shadow-xl font-['Barlow_Condensed'] uppercase tracking-wider hidden sm:block">
    ¡Chatea con un Asesor VIP 24/7!
  </div>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-floating-btn"
    class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-[0_10px_25px_rgba(37,211,102,0.45)] hover:shadow-[0_15px_35px_rgba(37,211,102,0.7)] hover:scale-110 transition-all duration-300 group opacity-0 translate-y-10 scale-50 pointer-events-none"
    aria-label="Contactar por WhatsApp Oficial TurisRam"
  >
    <!-- Anillo de pulso radiante continuo -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-35 group-hover:opacity-60 transition-opacity pointer-events-none"></span>
    
    <!-- Logo Oficial de WhatsApp Vector SVG -->
    <svg class="w-8 h-8 sm:w-9 sm:h-9 fill-current text-white relative z-10 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.758zm6.657-4.148l.38.225c1.47.872 3.176 1.332 4.92 1.333 5.385 0 9.768-4.383 9.771-9.768.002-2.607-1.013-5.059-2.86-6.907-1.847-1.847-4.298-2.862-6.906-2.863-5.386 0-9.77 4.384-9.773 9.77-.001 1.794.49 3.541 1.42 5.061l.247.4-.954 3.484 3.575-.935zm12.502-5.467c-.244-.122-1.444-.712-1.667-.793-.223-.081-.386-.122-.549.122-.163.245-.631.793-.773.955-.143.163-.285.184-.529.061-.244-.122-1.033-.381-1.968-1.214-.727-.648-1.218-1.449-1.361-1.694-.143-.245-.015-.377.107-.499.11-.11.244-.285.366-.428.122-.143.163-.245.244-.407.082-.163.041-.306-.02-.428-.062-.122-.549-1.323-.752-1.812-.198-.477-.4-.412-.549-.419h-.469c-.163 0-.428.061-.652.306-.224.245-.855.836-.855 2.039 0 1.203.876 2.364.998 2.527.122.163 1.724 2.632 4.177 3.689.583.252 1.038.403 1.393.516.586.186 1.12.16 1.542.097.471-.071 1.444-.591 1.648-1.162.204-.571.204-1.06.143-1.162-.061-.102-.224-.163-.468-.285z"/>
    </svg>
  </a>
</div>

<style>
  /* Animación de entrada con pop-bounce tras 2.8 segundos */
  @keyframes wa-pop-in {
    0% {
      opacity: 0;
      transform: translateY(40px) scale(0.4);
    }
    70% {
      opacity: 1;
      transform: translateY(-8px) scale(1.1);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
  }

  #whatsapp-floating-btn {
    animation: wa-pop-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 2.8s forwards;
  }
</style>
