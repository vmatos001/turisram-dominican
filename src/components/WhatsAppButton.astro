---
const phone = "18497527408";
const defaultMessage = encodeURIComponent("¡Hola TurisRam Dominicana! Me gustaría cotizar un servicio de transporte / tour.");
const whatsappUrl = `https://wa.me/${phone}?text=${defaultMessage}`;
---

<!-- BOTON CIRCULAR GRANDE OFICIAL WHATSAPP (FLATICON 3670051) POSICIONADO ALTO CON ANIMACIÓN DE ENTRADA -->
<div class="fixed bottom-8 right-8 sm:bottom-10 sm:right-10 z-50 pointer-events-auto">
  
  <!-- Tooltip sutil en hover -->
  <div class="absolute right-full top-1/2 -translate-y-1/2 mr-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none whitespace-nowrap bg-[#0A0A0A] border border-[#D4AF37]/50 text-[#F7F5F0] text-xs font-bold px-3.5 py-2 rounded-xl shadow-2xl font-['Barlow_Condensed'] uppercase tracking-wider hidden sm:block">
    ¡Chatea con un Asesor VIP 24/7!
  </div>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-floating-btn"
    class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-[0_12px_30px_rgba(37,211,102,0.55)] hover:shadow-[0_18px_45px_rgba(37,211,102,0.85)] hover:scale-110 transition-all duration-300 group opacity-0 translate-y-10 scale-50 pointer-events-none"
    aria-label="Contactar por WhatsApp Oficial TurisRam"
  >
    <!-- Anillo de pulso radiante continuo amplio -->
    <span class="absolute -inset-2 rounded-full bg-[#25D366] animate-ping opacity-35 group-hover:opacity-60 transition-opacity pointer-events-none"></span>
    
    <!-- Logo Oficial de WhatsApp (Flaticon 3670051) Vector SVG -->
    <svg class="w-10 h-10 sm:w-12 sm:h-12 fill-current text-white relative z-10 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24">
      <path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.12-.56.12-.17.25-.66.8-.81.97-.15.17-.3.19-.55.07-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.41 1.02 2.58.12.17 1.76 2.68 4.26 3.76.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.07-.1-.23-.16-.48-.28z"/>
    </svg>
  </a>
</div>

<style>
  /* Animación de entrada con pop-bounce tras 2.8 segundos */
  @keyframes wa-pop-in {
    0% {
      opacity: 0;
      transform: translateY(45px) scale(0.4);
    }
    70% {
      opacity: 1;
      transform: translateY(-10px) scale(1.15);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
  }

  #whatsapp-floating-btn {
    animation: wa-pop-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 2.8s forwards;
  }
</style>
