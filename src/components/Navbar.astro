---
const currentPath = Astro.url.pathname;
const phone = "18497527408";
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent("¡Hola TurisRam Dominicana! Deseo cotizar un traslado privado.")}`;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros", label: "Sobre Nosotros" },
  { href: "/servicios", label: "Servicios & Tours" },
  { href: "/contacto", label: "Contacto" },
];
---

<!-- TOP ANNOUNCEMENT BAR -->
<div class="bg-[#000000] text-[#F7F5F0] text-xs py-2 px-4 border-b border-white/10 hidden sm:block">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-6 text-gray-300">
      <span class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#D4AF37] fill-current" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        Soporte VIP 24/7: <a href="tel:+18497527408" class="text-[#D4AF37] hover:underline font-bold">+1 (849) 752-7408</a>
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Punta Cana, Santo Domingo, Santiago, Puerto Plata
      </span>
    </div>
    
    <!-- Enlaces / Iconos de Redes Sociales -->
    <div class="flex items-center gap-3 text-xs">
      <span class="text-gray-400 font-['Barlow_Condensed'] uppercase tracking-widest text-[11px]">Síguenos:</span>
      <!-- Google Maps -->
      <a
        href="https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#D4AF37] hover:text-white transition-colors"
        title="Ficha Oficial en Google Maps"
        aria-label="Google Maps TurisRam"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
      </a>

      <!-- WhatsApp -->
      <a
        href="https://wa.me/18497527408"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#D4AF37] hover:text-[#25D366] transition-colors"
        title="Contacto por WhatsApp"
        aria-label="WhatsApp TurisRam"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.12-.56.12-.17.25-.66.8-.81.97-.15.17-.3.19-.55.07-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.41 1.02 2.58.12.17 1.76 2.68 4.26 3.76.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.07-.1-.23-.16-.48-.28z"/></svg>
      </a>

      <!-- Instagram -->
      <a
        href="https://www.instagram.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#D4AF37] hover:text-[#E1306C] transition-colors"
        title="Instagram Oficial"
        aria-label="Instagram TurisRam"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>

      <!-- Facebook -->
      <a
        href="https://www.facebook.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#D4AF37] hover:text-[#1877F2] transition-colors"
        title="Facebook Oficial"
        aria-label="Facebook TurisRam"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
    </div>
  </div>
</div>

<!-- MAIN NAVBAR - FONDO NEGRO PURO #000000 IGUALADO AL LOGO & MENU CENTRADO -->
<header class="sticky top-0 z-40 bg-[#000000] text-white shadow-2xl border-b border-[#D4AF37]/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- 1. Logo a la Izquierda (Fondo negro igualado #000000) -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center group">
          <img 
            src="/images/logo-turisram.webp" 
            alt="TurisRam Dominicana — Transfers & Experiencias" 
            class="h-11 sm:h-13 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          />
        </a>
      </div>

      <!-- 2. Menú de Opciones CENTRADO en Escritorio -->
      <div class="hidden md:flex flex-1 justify-center items-center">
        <nav class="flex items-center gap-6 lg:gap-10 whitespace-nowrap">
          {navLinks.map(link => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`text-[11px] lg:text-xs font-bold uppercase tracking-wider transition-all duration-200 py-1.5 font-['Barlow_Condensed'] relative group flex items-center leading-none ${
                  isActive 
                    ? 'text-[#D4AF37]' 
                    : 'text-[#F7F5F0]/85 hover:text-[#D4AF37]'
                }`}
              >
                {link.label}
                <span class={`absolute bottom-0 left-0 h-0.5 bg-[#D4AF37] transition-all duration-300 ${isActive ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- 3. Botón CTA a la Derecha con Proporción Elegante -->
      <div class="hidden md:flex flex-shrink-0 items-center">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#D4AF37] text-[#0A0A0A] font-extrabold text-[11px] uppercase tracking-wider px-5 py-2.5 rounded-full hover:bg-white transition-all duration-300 font-['Barlow_Condensed'] flex items-center gap-1.5 shadow-md border border-[#D4AF37]/40 whitespace-nowrap hover:scale-105"
        >
          <svg class="w-3.5 h-3.5 fill-current text-[#0A0A0A]" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.758zm6.657-4.148l.38.225c1.47.872 3.176 1.332 4.92 1.333 5.385 0 9.768-4.383 9.771-9.768.002-2.607-1.013-5.059-2.86-6.907-1.847-1.847-4.298-2.862-6.906-2.863-5.386 0-9.77 4.384-9.773 9.77-.001 1.794.49 3.541 1.42 5.061l.247.4-.954 3.484 3.575-.935z"/></svg>
          Cotizar Traslado
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          class="text-[#F7F5F0] hover:text-[#D4AF37] focus:outline-none p-2 rounded-lg bg-white/5"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#000000] border-t border-white/10 px-4 pt-4 pb-6 space-y-3">
    {navLinks.map(link => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-xl text-sm font-bold font-['Barlow_Condensed'] text-center ${
            isActive ? 'bg-[#D4AF37] text-[#0A0A0A]' : 'text-[#F7F5F0] hover:bg-white/10'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-2">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center bg-[#D4AF37] text-[#0A0A0A] font-bold py-3 rounded-full font-['Barlow_Condensed'] uppercase text-xs tracking-wider"
      >
        Cotizar por WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
