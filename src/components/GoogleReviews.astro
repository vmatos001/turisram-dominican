---
const googleMapsLink = "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r";

const reviews = [
  {
    name: "Carlos M. Fernández",
    rating: 5,
    date: "Hace 2 semanas",
    comment: "Excelente servicio desde el aeropuerto de Punta Cana hasta el resort en Bávaro. Chofer super puntual, amable y la van estaba impecable con aire acondicionado helado.",
    avatar: "C"
  },
  {
    name: "Sarah & David Jenkins",
    rating: 5,
    date: "Hace 1 mes",
    comment: "Booked a private transfer from PUJ to Cap Cana and a day tour to Saona Island. TurisRam exceeded our expectations! Highly recommended, 10/10 service.",
    avatar: "S"
  },
  {
    name: "Mariana Alarcón",
    rating: 5,
    date: "Hace 3 semanas",
    comment: "La atención por WhatsApp es rápida e inmediata. El precio fue exactamente el pactado, sin cargos ocultos ni sorpresas en el aeropuerto. Definitivamente volveré a contratar con ellos.",
    avatar: "M"
  },
  {
    name: "Jean-Pierre Laurent",
    rating: 5,
    date: "Hace 2 meses",
    comment: "Service de transport VIP d'une qualité irréprochable. Chauffeur ponctuel et très professionnel à Santo Domingo. Merci TurisRam!",
    avatar: "J"
  }
];
---

<section class="py-20 bg-[#050505] text-[#F7F5F0] overflow-hidden relative border-t border-b border-[#D4AF37]/20">
  
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/2 left-0 w-96 h-96 bg-[#D4AF37]/5 rounded-full blur-3xl pointer-events-none -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#3B6998]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center mb-14">
      <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block mb-3">
        Reseñas Verificadas 5.0 ★
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] uppercase tracking-tight text-white leading-none">
        Lo Que Dicen <span class="text-[#D4AF37]">Nuestros Clientes</span>
      </h2>
      <p class="text-gray-300 mt-3 max-w-2xl mx-auto text-xs sm:text-sm font-['Barlow_Semi_Condensed']">
        Más de 500+ turistas y familias confían en TurisRam Dominicana para sus traslados privados y excursiones exclusivas.
      </p>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {reviews.map(rev => (
        <div class="bg-[#141414] border border-[#D4AF37]/30 p-6 rounded-3xl flex flex-col justify-between hover:border-[#D4AF37] transition-all duration-300 shadow-xl group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-[#D4AF37] text-[#0A0A0A] font-extrabold flex items-center justify-center text-sm font-['Barlow_Condensed'] shadow-md">
                  {rev.avatar}
                </div>
                <div>
                  <h4 class="font-bold text-sm text-white font-['Barlow_Condensed']">{rev.name}</h4>
                  <span class="text-[10px] text-gray-400 font-['Barlow_Semi_Condensed']">{rev.date}</span>
                </div>
              </div>
            </div>

            <!-- Stars -->
            <div class="flex items-center gap-1 mb-3">
              {[...Array(rev.rating)].map(() => (
                <svg class="w-4 h-4 text-[#D4AF37] fill-current" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              ))}
            </div>

            <p class="text-xs text-gray-300 italic leading-relaxed font-['Barlow_Semi_Condensed']">
              "{rev.comment}"
            </p>
          </div>

          <div class="mt-6 pt-3 border-t border-white/10 flex items-center gap-1.5 text-[11px] text-[#D4AF37] font-['Barlow_Condensed']">
            <svg class="w-3.5 h-3.5 fill-current text-[#D4AF37]" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            <span>Verificado en Google Business</span>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA Google Review -->
    <div class="text-center mt-12">
      <a
        href={googleMapsLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#D4AF37] text-[#0A0A0A] font-extrabold text-xs uppercase tracking-wider px-7 py-3.5 rounded-full hover:bg-white transition-all duration-300 font-['Barlow_Condensed'] shadow-xl border border-white/20 hover:scale-105"
      >
        <svg class="w-4 h-4 fill-current text-[#0A0A0A]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Ver Ficha Oficial en Google Maps &rarr;
      </a>
    </div>

  </div>
</section>
