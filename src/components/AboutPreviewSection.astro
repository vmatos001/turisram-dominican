---
---

<!-- SECCIÓN SOBRE NOSOTROS PREVIEW CON ICONOS SOCIALES REUBICADOS MÁS A LA IZQUIERDA Y COLOR DORADO UNIFICADO -->
<section class="py-20 lg:py-28 px-4 bg-[#050505] text-[#F7F5F0] border-b border-[#D4AF37]/20 relative overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <div class="relative">
      
      <!-- 1. Tagline Insignia Reubicada en la Muesca Izquierda -->
      <div class="absolute top-2 sm:top-3 left-4 sm:left-8 z-20 flex items-center gap-2">
        <span class="text-[#D4AF37] animate-spin text-lg sm:text-xl">✱</span>
        <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md">
          SOBRE NOSOTROS
        </span>
      </div>

      <!-- 2. Iconos de Redes Sociales Completo (Desplazados a la izquierda para encajar perfectamente en la muesca) -->
      <div class="absolute top-2 sm:top-3 right-24 sm:right-44 z-20 flex gap-2 sm:gap-2.5">
        <!-- Icono Google Maps -->
        <a
          href="https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.6566542,-72.7709679,7z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r"
          target="_blank"
          rel="noopener noreferrer"
          class="w-7 h-7 sm:w-8 sm:h-8 border border-[#D4AF37]/30 bg-[#141414]/90 backdrop-blur-md rounded-lg flex items-center justify-center text-[#D4AF37] hover:bg-[#D4AF37] hover:text-[#0A0A0A] transition-all shadow-md"
          title="Ficha Oficial en Google Maps"
          aria-label="Google Maps TurisRan"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        </a>

        <!-- Icono WhatsApp -->
        <a
          href="https://wa.me/18497527408?text=¡Hola!%20Me%20gustaría%20saber%20más%20sobre%20TurisRan"
          target="_blank"
          rel="noopener noreferrer"
          class="w-7 h-7 sm:w-8 sm:h-8 border border-[#D4AF37]/30 bg-[#141414]/90 backdrop-blur-md rounded-lg flex items-center justify-center text-[#D4AF37] hover:bg-[#25D366] hover:text-white hover:border-[#25D366] transition-all shadow-md"
          title="Contacto por WhatsApp"
          aria-label="WhatsApp TurisRan"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.12-.56.12-.17.25-.66.8-.81.97-.15.17-.3.19-.55.07-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.41 1.02 2.58.12.17 1.76 2.68 4.26 3.76.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.07-.1-.23-.16-.48-.28z"/></svg>
        </a>

        <!-- Icono Instagram -->
        <a
          href="https://www.instagram.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-7 h-7 sm:w-8 sm:h-8 border border-[#D4AF37]/30 bg-[#141414]/90 backdrop-blur-md rounded-lg flex items-center justify-center text-[#D4AF37] hover:bg-[#E1306C] hover:text-white hover:border-[#E1306C] transition-all shadow-md"
          title="Instagram Oficial"
          aria-label="Instagram TurisRan"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>

        <!-- Icono Facebook -->
        <a
          href="https://www.facebook.com/profile.php?id=61577764472405"
          target="_blank"
          rel="noopener noreferrer"
          class="w-7 h-7 sm:w-8 sm:h-8 border border-[#D4AF37]/30 bg-[#141414]/90 backdrop-blur-md rounded-lg flex items-center justify-center text-[#D4AF37] hover:bg-[#1877F2] hover:text-white hover:border-[#1877F2] transition-all shadow-md"
          title="Facebook Oficial"
          aria-label="Facebook TurisRan"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>

        <!-- Icono TikTok -->
        <a
          href="https://www.tiktok.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-7 h-7 sm:w-8 sm:h-8 border border-[#D4AF37]/30 bg-[#141414]/90 backdrop-blur-md rounded-lg flex items-center justify-center text-[#D4AF37] hover:bg-[#EE1D52] hover:text-white hover:border-[#EE1D52] transition-all shadow-md"
          title="TikTok Oficial"
          aria-label="TikTok TurisRan"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.85.12V9.4a6.33 6.33 0 0 0-.85-.05A6.34 6.34 0 0 0 3.14 15.7a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.82-.06 4.79 4.79 0 0 1-1.36-.5z"/></svg>
        </a>
      </div>

      <!-- Figura de Imagen Principal Sin Borde Exterior -->
      <figure data-reveal="scale-up" class="relative group my-2 overflow-hidden shadow-2xl">
        <svg
          class="w-full h-auto"
          width="100%"
          height="100%"
          viewBox="0 0 100 40"
        >
          <defs>
            <clipPath id="clip-inverted-turisran" clipPathUnits="objectBoundingBox">
              <path
                d="M0.0998072 1H0.422076H0.749756C0.767072 1 0.774207 0.961783 0.77561 0.942675V0.807325C0.777053 0.743631 0.791844 0.731953 0.799059 0.734076H0.969813C0.996268 0.730255 1.00088 0.693206 0.999875 0.675159V0.0700637C0.999875 0.0254777 0.985045 0.00477707 0.977629 0H0.902473C0.854975 0 0.890448 0.138535 0.850165 0.138535H0.0204424C0.00408849 0.142357 0 0.180467 0 0.199045V0.410828C0 0.449045 0.0136283 0.46603 0.0204424 0.469745H0.0523086C0.0696245 0.471019 0.0735527 0.497877 0.0733523 0.511146V0.915605C0.0723903 0.983121 0.090588 1 0.0998072 1Z"
                fill="#D9D9D9"
              ></path>
            </clipPath>
          </defs>
          <image
            clip-path="url(#clip-inverted-turisran)"
            preserveAspectRatio="xMidYMid slice"
            width="100%"
            height="100%"
            href="/images/-create-a-vibrant-and-welcoming-website-header-ima.webp"
            xlink:href="/images/-create-a-vibrant-and-welcoming-website-header-ima.webp"
          ></image>
        </svg>

        <!-- Texto "100% Cobertura Nacional" Dentro de la Muesca Inferior Derecha -->
        <div data-reveal="fade-up" data-duration="1.3" data-distance="50" data-delay="0.2" data-ease="power3.out" class="absolute bottom-2 sm:bottom-4 right-4 sm:right-8 z-20 text-right">
          <div class="flex items-center gap-1.5 justify-end">
            <span data-reveal-count="100" data-suffix="%" class="text-[#D4AF37] font-extrabold text-xl sm:text-3xl font-['Barlow_Condensed'] drop-shadow-md">0%</span>
            <span class="text-white uppercase font-bold text-xs sm:text-sm font-['Barlow_Condensed'] tracking-wider drop-shadow">COBERTURA NACIONAL</span>
          </div>
          <div class="flex items-center gap-1.5 justify-end text-[10px] sm:text-xs text-gray-300 drop-shadow">
            <span class="text-[#D4AF37] font-bold">5.0 ★</span>
            <span>Garantía de Satisfacción</span>
          </div>
        </div>
      </figure>

      <!-- Barra de Estadísticas de Experiencia (Parte A: De derecha a izquierda) -->
      <div data-reveal="fade-right" data-duration="1.3" data-distance="70" data-delay="0.1" data-ease="power3.out" class="flex flex-wrap items-center py-3 text-sm font-['Barlow_Semi_Condensed']">
        <div class="flex flex-wrap gap-4 sm:gap-6">
          <div class="flex items-center gap-2">
            <span data-reveal-count="10" data-suffix="+ AÑOS" class="text-[#D4AF37] font-extrabold text-base sm:text-lg font-['Barlow_Condensed']">0+ AÑOS</span>
            <span class="text-gray-300">de experiencia en traslados VIP</span>
            <span class="text-[#D4AF37]/40">|</span>
          </div>
          <div class="flex items-center gap-2">
            <span data-reveal-count="9800" data-suffix="+" class="text-[#D4AF37] font-extrabold text-base sm:text-lg font-['Barlow_Condensed']">0+</span>
            <span class="text-gray-300">pasajeros satisfechos</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Contenido Principal de Copy & Historia -->
    <div class="grid md:grid-cols-3 gap-8 sm:gap-12 mt-8 items-start">
      
      <!-- Columna Titular y Párrafos (Parte A: De derecha a izquierda) -->
      <div data-reveal="fade-right" data-duration="1.4" data-distance="80" data-delay="0.2" data-ease="power3.out" class="md:col-span-2 space-y-5">
        <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] text-white uppercase leading-[1.1] tracking-tight drop-shadow-lg">
          Creamos Experiencias de Viaje <br />
          <span class="text-[#D4AF37]">Inolvidables en República Dominicana.</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-6 text-gray-300 text-xs sm:text-sm font-['Barlow_Semi_Condensed'] leading-relaxed">
          <p class="text-justify">
            Nuestra trayectoria comenzó con la visión de transformar el transporte turístico tradicional en una experiencia ejecutiva de máxima puntualidad, confort y seguridad. Nos especializamos en conectar a nuestros pasajeros con los destinos más hermosos del país.
          </p>
          <p class="text-justify">
            Cada viajero tiene una expectativa única. En TurisRan Dominicana combinamos conductores certificados y bilingües con una flota VIP impecable y atención constante 24/7 por WhatsApp para garantizar que tu llegada y estadía sean perfectas.
          </p>
        </div>
      </div>

      <!-- Columna Derecha: Firma Corporativa & CTA (Parte B: De abajo hacia arriba) -->
      <div data-reveal="fade-up" data-duration="1.4" data-distance="80" data-delay="0.35" data-ease="power3.out" class="md:col-span-1 text-right flex flex-col items-end justify-start space-y-5 pt-0">
        <div>
          <div class="text-[#D4AF37] text-2xl font-extrabold font-['Barlow_Condensed'] tracking-wider uppercase mb-1 drop-shadow-md">
            TURISRAN DOMINICANA
          </div>
          <div class="text-gray-400 text-xs font-['Barlow_Semi_Condensed'] mb-4 uppercase tracking-widest">
            Transfers Executivos & Experiencias VIP
          </div>

          <p class="text-white font-bold text-sm mb-5 font-['Barlow_Semi_Condensed']">
            ¿Listo para vivir la mejor experiencia de traslado en Dominicana?
          </p>
        </div>

        <a
          href="/nosotros"
          class="butn-arrow hover:scale-105"
        >
          <span>Conoce Más Sobre Nosotros</span>
          <span class="arrow-wrap"><i class="text-[#0A0A0A] font-bold">&rarr;</i></span>
        </a>
      </div>

    </div>
  </div>
</section>
