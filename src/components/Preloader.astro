---
/* Preloader.astro — Ultra-lightweight preloader for fast FCP */
---

<div 
  id="preloader" 
  class="fixed inset-0 z-[99999] bg-[#000000] flex items-center justify-center select-none pointer-events-auto"
  style="transition: opacity 0.3s ease-out;"
>
  <img 
    src="/images/logo-turisram.webp" 
    alt="TurisRan Dominicana" 
    width="96"
    height="40"
    class="h-10 sm:h-14 w-auto object-contain"
  />
</div>

<script is:inline>
  (function() {
    var p = document.getElementById('preloader');
    if (!p) return;
    function hide() {
      if (p.dataset.h) return;
      p.dataset.h = '1';
      p.style.opacity = '0';
      p.style.pointerEvents = 'none';
      setTimeout(function() { p.style.display = 'none'; }, 300);
    }
    if (document.readyState !== 'loading') { hide(); }
    else { document.addEventListener('DOMContentLoaded', hide, { once: true }); }
    setTimeout(hide, 600);
  })();
</script>
