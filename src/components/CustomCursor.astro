---
/* CustomCursor.astro — Puntero Custom VIP en Negativo ultra-responsivo */
---

<!-- Elementos del Puntero Custom (Oculto por defecto en pantallas táctiles) -->
<div id="custom-cursor-container" class="hidden md:block pointer-events-none">
  <!-- Anillo exterior seguidor (Sin lag CSS, controlado por LERP 0.35) -->
  <div 
    id="cursor-follower" 
    class="fixed top-0 left-0 w-9 h-9 rounded-full border border-white/80 z-[99998] pointer-events-none -translate-x-1/2 -translate-y-1/2 mix-blend-difference"
  ></div>

  <!-- Punto central (Sin lag CSS, pegado 1:1 al puntero del mouse) -->
  <div 
    id="cursor-dot" 
    class="fixed top-0 left-0 w-2.5 h-2.5 rounded-full bg-white z-[99999] pointer-events-none -translate-x-1/2 -translate-y-1/2 mix-blend-difference"
  ></div>
</div>

<script>
  function initCustomCursor() {
    // Desactivar completamente en dispositivos táctiles o pantallas móviles/tablets
    if (window.innerWidth < 1024 || window.matchMedia('(pointer: coarse)').matches || (navigator.maxTouchPoints && navigator.maxTouchPoints > 0)) {
      return;
    }

    const follower = document.getElementById('cursor-follower');
    const dot = document.getElementById('cursor-dot');
    const container = document.getElementById('custom-cursor-container');

    if (!follower || !dot || !container) return;

    let mouseX = -100;
    let mouseY = -100;
    let followerX = -100;
    let followerY = -100;
    let isHovering = false;
    let isVisible = false;
    let isTicking = false;

    function render() {
      const dx = mouseX - followerX;
      const dy = mouseY - followerY;
      
      followerX += dx * 0.35;
      followerY += dy * 0.35;

      const scale = isHovering ? 2.0 : 1;
      follower.style.transform = `translate3d(${followerX}px, ${followerY}px, 0) scale(${scale})`;

      if (Math.abs(dx) > 0.1 || Math.abs(dy) > 0.1) {
        requestAnimationFrame(render);
      } else {
        isTicking = false;
      }
    }

    function onMouseMove(e) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) scale(${isHovering ? 0.5 : 1})`;

      if (!isVisible) {
        isVisible = true;
        container.style.opacity = '1';
        followerX = mouseX;
        followerY = mouseY;
      }

      if (!isTicking) {
        isTicking = true;
        requestAnimationFrame(render);
      }
    }

    // Detectar hover sobre elementos interactivos
    function addHoverListeners() {
      const interactiveElements = document.querySelectorAll('a, button, input, select, textarea, [role="button"], .interactive-hover');

      interactiveElements.forEach((el) => {
        el.addEventListener('mouseenter', () => {
          isHovering = true;
          follower.classList.add('bg-white/20', 'border-white');
        });
        el.addEventListener('mouseleave', () => {
          isHovering = false;
          follower.classList.remove('bg-white/20', 'border-white');
        });
      });
    }

    // Ocultar/Mostrar al salir/entrar a la ventana
    document.addEventListener('mouseleave', () => {
      container.style.opacity = '0';
      isVisible = false;
    });

    document.addEventListener('mouseenter', () => {
      container.style.opacity = '1';
      isVisible = true;
    });

    window.addEventListener('mousemove', onMouseMove, { passive: true });
    
    render();
    addHoverListeners();

    document.addEventListener('astro:page-load', addHoverListeners);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomCursor);
  } else {
    initCustomCursor();
  }

  document.addEventListener('astro:after-swap', initCustomCursor);
</script>

<style>
  #custom-cursor-container {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
</style>
