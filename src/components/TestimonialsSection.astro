---
interface Stat {
  value: string;
  label: string;
}

interface Testimonial {
  name: string;
  title: string;
  quote: string;
  avatarSrc: string;
  rating: number;
}

const stats: Stat[] = [
  { value: "5.0 ★", label: "Calificación Google" },
  { value: "100%", label: "Puntualidad VIP" },
  { value: "24/7", label: "Soporte WhatsApp" }
];

const testimonials: Testimonial[] = [
  {
    name: "Kimberlin Montero",
    title: "Reseña Verificada en Google Maps 5★",
    quote: "Excelente conductor. El servicio de este conductor fue excepcionalmente profesional y atento; llegó puntual con un vehículo impecable, demostrando gran habilidad al volante y un conocimiento eficiente de las rutas. Su amabilidad y cortesía, combinadas con una conducción segura y suave, crearon una experiencia de viaje cómoda y relajante.",
    avatarSrc: "/images/avatars/avatar-1.webp",
    rating: 5
  },
  {
    name: "Familia Isasi",
    title: "Reseña Verificada en Google Maps 5★",
    quote: "Ransel muy profesional, nos trajo a Samaná desde Bayahibe. El viaje fue muy agradable y ameno. Buen coche y muy buena conducción. Es de total confianza.",
    avatarSrc: "/images/avatars/avatar-2.webp",
    rating: 5
  },
  {
    name: "Rafalis Montero Medina",
    title: "Reseña Verificada en Google Maps 5★",
    quote: "Excelente servicio la verdad, buen confort en el vehículo, altamente responsable y todo servido exactamente a tiempo.",
    avatarSrc: "/images/avatars/avatar-3.webp",
    rating: 5
  },
  {
    name: "Mercedes Dolores Méndez Matos",
    title: "Local Guide • Reseña Verificada en Google 5★",
    quote: "Trato agradable y persona de absoluta confianza, lo recomiendo 100%. Vehículo cómodo, limpio y muy confortable.",
    avatarSrc: "/images/avatars/avatar-4.webp",
    rating: 5
  },
  {
    name: "Acelis Grisel Montero Medina",
    title: "Reseña Verificada en Google Maps 5★",
    quote: "Excelente servicio, máximo respeto y muy amable el conductor. Servicio 100% recomendable para viajar en República Dominicana.",
    avatarSrc: "/images/avatars/avatar-5.webp",
    rating: 5
  }
];

const googleMapsUrl = "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.6566542,-72.7709679,7z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r?entry=ttu&g_ep=EgoyMDI2MDgxMS4wIKXMDSoASAFQAw%3D%3D";
const writeReviewUrl = "https://g.page/r/CQIGM1irEXmnEBM/review";
---

<!-- SECCIÓN DE TESTIMONIOS STICKY STACKING CON RESEÑAS REALES DE GOOGLE -->
<section id="testimonials-section" class="w-full bg-[#0A0A0A] text-[#F7F5F0] py-20 lg:py-28 border-b border-[#D4AF37]/20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    
    <!-- COLUMNA IZQUIERDA: CONTENIDO STICKY (Parte A: De izquierda a derecha) -->
    <div class="testimonials-left-col lg:col-span-5 flex flex-col gap-6 lg:sticky lg:top-28">
      
      <!-- Cápsula Dorada -->
      <div>
        <span class="bg-[#D4AF37] text-[#0A0A0A] text-xs sm:text-sm font-extrabold px-5 py-1.5 rounded-full uppercase tracking-widest font-['Barlow_Condensed'] shadow-md inline-block">
          EXPERIENCIAS REALES DE CLIENTES
        </span>
      </div>

      <!-- Título H2 -->
      <h2 class="text-3xl sm:text-5xl font-extrabold font-['Barlow_Condensed'] tracking-tight text-white uppercase leading-none drop-shadow-lg">
        Lo que Dicen Nuestros <br />
        <span class="text-[#D4AF37]">Pasajeros VIP</span>
      </h2>

      <!-- Descripción -->
      <p class="text-sm sm:text-base text-gray-300 font-['Barlow_Semi_Condensed'] leading-relaxed">
        Reseñas reales y verificadas de nuestros clientes en el perfil de negocio oficial de Google Maps de TurisRan Dominicana.
      </p>

      <!-- Grid de 3 Estadísticas Clave -->
      <div class="grid grid-cols-3 gap-3 sm:gap-4 mt-2">
        {stats.map((stat) => (
          <div class="bg-[#141414] border border-[#D4AF37]/30 text-center rounded-2xl p-4 shadow-xl hover:border-[#D4AF37] transition-all">
            <p class="text-xl sm:text-2xl font-extrabold text-[#D4AF37] font-['Barlow_Condensed']">{stat.value}</p>
            <p class="text-[11px] sm:text-xs text-gray-400 font-['Barlow_Semi_Condensed'] mt-1">{stat.label}</p>
          </div>
        ))}
      </div>

      <!-- Botones CTA -->
      <div class="flex flex-col sm:flex-row items-center gap-4 mt-4">
        <a
          href={writeReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto butn-arrow"
        >
          <span>Escribe una reseña</span>
          <span class="arrow-wrap"><i class="text-[#0A0A0A] font-bold">&rarr;</i></span>
        </a>
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto bg-white/10 backdrop-blur-md border border-white/20 text-white font-bold text-xs uppercase tracking-wider px-6 py-4 rounded-full hover:bg-white/20 transition-all font-['Barlow_Condensed'] text-center"
        >
          Ver Reseñas Google 5★
        </a>
      </div>

    </div>

    <!-- COLUMNA DERECHA: RESEÑAS REALES DE GOOGLE MAPS (Parte B: Escalonada de izquierda a derecha siguiendo a la primera) -->
    <div class="testimonials-right-col lg:col-span-7 flex flex-col gap-6 relative">
      {testimonials.map((t, index) => (
        <div
          class="sticky w-full"
          style={`top: ${100 + index * 28}px; z-index: ${10 + index};`}
        >
          <div class="testimonial-inner-card p-6 sm:p-8 rounded-3xl shadow-2xl flex flex-col h-auto w-full bg-[#141414] border border-[#D4AF37]/30 backdrop-blur-md hover:border-[#D4AF37] transition-colors duration-300">
            
            <!-- Sección Superior: Avatar y Nombre -->
            <div class="flex items-center gap-4">
              <img
                src={t.avatarSrc}
                alt={`Foto de ${t.name}`}
                width="56"
                height="56"
                loading="lazy"
                decoding="async"
                class="w-14 h-14 rounded-2xl object-cover border-2 border-[#D4AF37]/50 shadow-md flex-shrink-0"
              />
              <div class="flex-grow">
                <p class="font-bold text-lg text-white font-['Barlow_Condensed'] uppercase tracking-wide">{t.name}</p>
                <p class="text-xs text-[#D4AF37] font-['Barlow_Semi_Condensed'] flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 fill-current text-[#4285F4]" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                  <span>{t.title}</span>
                </p>
              </div>
            </div>

            <!-- Sección Media: Estrellas de Calificación -->
            <div class="flex items-center gap-2 my-4">
              <span class="font-extrabold text-base text-[#D4AF37] font-['Barlow_Condensed']">{t.rating.toFixed(1)}</span>
              <div class="flex gap-1 text-[#D4AF37]">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                ))}
              </div>
            </div>

            <!-- Sección Inferior: Cita/Testimonio Real -->
            <p class="text-xs sm:text-sm text-gray-200 font-['Barlow_Semi_Condensed'] italic leading-relaxed">
              &ldquo;{t.quote}&rdquo;
            </p>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  function initTestimonialsAnimation() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initTestimonialsAnimation, 60);
      return;
    }
    
    gsap.registerPlugin(ScrollTrigger);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const section = document.getElementById('testimonials-section');
    if (!section) return;

    const leftCol = section.querySelector('.testimonials-left-col');
    const cards = section.querySelectorAll('.testimonial-inner-card');

    if (!leftCol || cards.length === 0) return;

    // Timeline sincronizada cuando la sección entra en el 92% superior de la pantalla
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 92%',
        toggleActions: 'play none none none',
        fastScrollEnd: true,
      },
    });

    // 1. Parte A: Columna izquierda entra fluidamente de izquierda a derecha
    tl.from(leftCol, {
      opacity: 0,
      x: -75,
      duration: 1.2,
      ease: 'power3.out',
    });

    // 2. Parte B: Tarjetas entran en cascada de izquierda a derecha siguiendo a la primera
    tl.from(cards, {
      opacity: 0,
      x: -80,
      duration: 1.1,
      ease: 'power3.out',
      stagger: 0.16,
      clearProps: 'transform', // Importante: limpiar transforms para que sticky stacking funcione impecable
    }, '-=0.75');

    // Refrescar ScrollTrigger al cargar avatares o imágenes de la sección
    section.querySelectorAll('img').forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', () => {
          if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
        }, { once: true });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTestimonialsAnimation);
  } else {
    initTestimonialsAnimation();
  }

  window.addEventListener('load', () => {
    if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
  });
  document.addEventListener('astro:page-load', initTestimonialsAnimation);
</script>
