---
// ScrollAnimations.astro - Componente global para control de animaciones con GSAP ScrollTrigger
---

<script is:inline>
  function initGSAPAnimations() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initGSAPAnimations, 60);
      return;
    }
    
    gsap.registerPlugin(ScrollTrigger);

    // Si el usuario prefiere movimiento reducido por accesibilidad
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
      return;
    }

    // 1. Elementos individuales con data-reveal
    const revealElements = document.querySelectorAll('[data-reveal]:not([data-reveal="stagger"])');

    revealElements.forEach((el) => {
      const type = el.getAttribute('data-reveal') || 'fade-up';
      const delay = parseFloat(el.getAttribute('data-delay') || '0');
      const duration = parseFloat(el.getAttribute('data-duration') || '1.0');
      const start = el.getAttribute('data-start') || 'top 95%';
      const customDistance = parseFloat(el.getAttribute('data-distance') || '0');
      const ease = el.getAttribute('data-ease') || 'power3.out';
      const dist = customDistance || 60;

      let fromVars = {
        opacity: 0,
        duration: duration,
        delay: delay,
        ease: ease,
        clearProps: 'transform',
        scrollTrigger: {
          trigger: el,
          start: start,
          toggleActions: 'play none none none',
          fastScrollEnd: true,
        },
      };

      if (type === 'fade-up' || type === 'fade-from-bottom' || type === 'slide-up') {
        fromVars.y = customDistance || 45;
      } else if (type === 'fade-down' || type === 'fade-from-top' || type === 'slide-down') {
        fromVars.y = -(customDistance || 45);
      } else if (type === 'fade-left' || type === 'fade-from-left' || type === 'slide-right') {
        fromVars.x = -dist;
      } else if (type === 'fade-right' || type === 'fade-from-right' || type === 'slide-left') {
        fromVars.x = dist;
      } else if (type === 'zoom-center' || type === 'scale-center' || type === 'fade-center') {
        fromVars.scale = 0.82;
        fromVars.transformOrigin = 'center center';
      } else if (type === 'scale-up') {
        fromVars.scale = 0.92;
        fromVars.y = 20;
      } else if (type === 'flip-up') {
        fromVars.rotationX = 25;
        fromVars.y = 35;
        fromVars.transformOrigin = 'center top';
      }

      gsap.from(el, fromVars);
    });

    // 2. Elementos Stagger (cascada en listas o rejillas de tarjetas)
    const staggerContainers = document.querySelectorAll('[data-reveal="stagger"]');

    staggerContainers.forEach((container) => {
      const items = container.querySelectorAll('[data-reveal-item]');
      if (items.length === 0) return;

      const staggerTime = parseFloat(container.getAttribute('data-stagger') || '0.15');
      const start = container.getAttribute('data-start') || 'top 92%';
      const delay = parseFloat(container.getAttribute('data-delay') || '0');
      const duration = parseFloat(container.getAttribute('data-duration') || '1.0');
      const dir = container.getAttribute('data-stagger-type') || container.getAttribute('data-direction') || 'fade-up';
      const customDist = parseFloat(container.getAttribute('data-distance') || '0');
      const dist = customDist || 60;
      const ease = container.getAttribute('data-ease') || 'power3.out';

      let fromVars = {
        opacity: 0,
        duration: duration,
        delay: delay,
        ease: ease,
        stagger: staggerTime,
        clearProps: 'transform',
        scrollTrigger: {
          trigger: container,
          start: start,
          toggleActions: 'play none none none',
          fastScrollEnd: true,
        },
      };

      if (dir === 'fade-left' || dir === 'fade-from-left' || dir === 'slide-right') {
        fromVars.x = -dist;
      } else if (dir === 'fade-right' || dir === 'fade-from-right' || dir === 'slide-left') {
        fromVars.x = dist;
      } else if (dir === 'fade-down' || dir === 'fade-from-top' || dir === 'slide-down') {
        fromVars.y = -dist;
      } else {
        fromVars.y = dist || 40;
        fromVars.scale = 0.95;
      }

      gsap.from(items, fromVars);
    });

    // 3. Animación de métricas / contadores numéricos (data-reveal-count="100")
    const countElements = document.querySelectorAll('[data-reveal-count]');
    countElements.forEach((el) => {
      const targetVal = parseFloat(el.getAttribute('data-reveal-count') || '0');
      const suffix = el.getAttribute('data-suffix') || '';
      const prefix = el.getAttribute('data-prefix') || '';
      const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);

      const obj = { val: 0 };

      gsap.to(obj, {
        val: targetVal,
        duration: 1.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 92%',
          toggleActions: 'play none none none',
        },
        onUpdate: () => {
          el.innerText = `${prefix}${obj.val.toFixed(decimals)}${suffix}`;
        },
      });
    });

    // 4. Parallax sutil en elementos con data-parallax
    const parallaxElements = document.querySelectorAll('[data-parallax]');
    parallaxElements.forEach((el) => {
      const speed = parseFloat(el.getAttribute('data-parallax-speed') || '0.15');
      gsap.to(el, {
        yPercent: speed * 100,
        ease: 'none',
        scrollTrigger: {
          trigger: el,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        },
      });
    });

    // 5. Monitoreo y refresco de ScrollTrigger al cargar imágenes
    document.querySelectorAll('img').forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', () => {
          if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
        }, { once: true });
      }
    });

    // 6. Refrescar en múltiples intervalos para compensar layouts dinámicos
    [100, 300, 600, 1200, 2500].forEach((ms) => {
      setTimeout(() => {
        if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
      }, ms);
    });
  }

  // Inicializar al cargar el DOM o al navegar entre páginas
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGSAPAnimations);
  } else {
    initGSAPAnimations();
  }

  window.addEventListener('load', () => {
    if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
  });
  document.addEventListener('astro:page-load', initGSAPAnimations);
</script>
