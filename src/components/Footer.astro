---
const currentYear = new Date().getFullYear();
const googleMapsLink = "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r";
---

<footer class="bg-[#030303] text-[#F7F5F0] pt-16 pb-6 border-t border-[#D4AF37]/30 relative overflow-hidden">
  
  <!-- Texto Gigante Watermark "TURISRAM" de Fondo (Alineado al fondo inferior sin espacio muerto abajo en PC) -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full text-center overflow-hidden pointer-events-none select-none z-0 hidden md:block">
    <span class="text-[17vw] lg:text-[18.5vw] font-extrabold text-white/[0.04] uppercase tracking-widest font-['Barlow_Condensed'] leading-[0.85] block">
      TURISRAM
    </span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 lg:gap-12 mb-12 items-start">
      
      <!-- RECUADRO A: Marca & Logo Ampliado (Centrado en Móvil) -->
      <div class="col-span-2 md:col-span-2 lg:col-span-1 space-y-4 text-center sm:text-left flex flex-col items-center sm:items-start">
        <a href="/" class="inline-block">
          <img
            src="/images/logo-turisram.webp"
            alt="TurisRam Dominicana Logo"
            class="h-28 sm:h-32 lg:h-36 w-auto object-contain max-w-full drop-shadow-2xl mx-auto sm:mx-0"
          />
        </a>
        <p class="text-xs text-gray-400 leading-relaxed font-['Barlow_Semi_Condensed'] max-w-sm sm:max-w-none">
          Empresa líder en servicios de transporte privado VIP, traslados desde aeropuertos y tours exclusivos en la República Dominicana.
        </p>
        <p class="text-sm font-bold text-[#D4AF37] italic font-['Lora']">
          "Viaja cómodo. Llega seguro."
        </p>

        <!-- Fila de Iconos de Redes Sociales (Centrado en Móvil) -->
        <div class="pt-2 w-full flex flex-col items-center sm:items-start">
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest font-['Barlow_Condensed'] mb-2.5">
            Síguenos & Contáctanos:
          </p>
          <div class="flex items-center justify-center sm:justify-start gap-3">
            <!-- Google Maps Icon -->
            <a
              href={googleMapsLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 border border-[#D4AF37]/40 bg-[#141414] rounded-xl flex items-center justify-center text-[#D4AF37] hover:bg-[#D4AF37] hover:text-[#0A0A0A] transition-all shadow-md"
              title="Ficha Oficial en Google Maps"
              aria-label="Google Maps TurisRam"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </a>

            <!-- WhatsApp Icon -->
            <a
              href="https://wa.me/18497527408"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 border border-[#D4AF37]/40 bg-[#141414] rounded-xl flex items-center justify-center text-[#D4AF37] hover:bg-[#25D366] hover:text-white hover:border-[#25D366] transition-all shadow-md"
              title="Contacto Directo por WhatsApp"
              aria-label="WhatsApp TurisRam"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.12-.56.12-.17.25-.66.8-.81.97-.15.17-.3.19-.55.07-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.41 1.02 2.58.12.17 1.76 2.68 4.26 3.76.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.07-.1-.23-.16-.48-.28z"/></svg>
            </a>

            <!-- Instagram Icon -->
            <a
              href="https://www.instagram.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 border border-[#D4AF37]/40 bg-[#141414] rounded-xl flex items-center justify-center text-[#D4AF37] hover:bg-[#E1306C] hover:text-white hover:border-[#E1306C] transition-all shadow-md"
              title="Instagram Oficial"
              aria-label="Instagram TurisRam"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>

            <!-- Facebook Icon -->
            <a
              href="https://www.facebook.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 border border-[#D4AF37]/40 bg-[#141414] rounded-xl flex items-center justify-center text-[#D4AF37] hover:bg-[#1877F2] hover:text-white hover:border-[#1877F2] transition-all shadow-md"
              title="Facebook Oficial"
              aria-label="Facebook TurisRam"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- RECUADRO B: Navegación & Cobertura Aeropuertos (En 2 columnas en Móvil) -->
      <div class="col-span-1 sm:col-span-1">
        <h4 class="text-sm font-bold text-[#D4AF37] uppercase tracking-wider mb-4 font-['Barlow_Condensed'] border-b border-[#D4AF37]/30 pb-2 inline-block">Navegación</h4>
        <ul class="space-y-2.5 text-xs text-gray-400 font-['Barlow_Condensed']">
          <li><a href="/" class="hover:text-[#D4AF37] transition-colors">Inicio</a></li>
          <li><a href="/nosotros" class="hover:text-[#D4AF37] transition-colors">Sobre Nosotros</a></li>
          <li><a href="/servicios" class="hover:text-[#D4AF37] transition-colors">Servicios & Tours</a></li>
          <li><a href="/contacto" class="hover:text-[#D4AF37] transition-colors">Contacto & Cotización</a></li>
        </ul>
      </div>

      <div class="col-span-1 sm:col-span-1">
        <h4 class="text-sm font-bold text-[#3B6998] uppercase tracking-wider mb-4 font-['Barlow_Condensed'] border-b border-[#3B6998]/30 pb-2 inline-block">Cobertura Aeropuertos</h4>
        <ul class="space-y-2.5 text-xs text-gray-400 font-['Barlow_Semi_Condensed']">
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current flex-shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Punta Cana (PUJ)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current flex-shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Las Américas (SDQ)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current flex-shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>La Romana (LRM)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current flex-shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Cibao Santiago (STI)</span>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current flex-shrink-0" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Puerto Plata (POP)</span>
          </li>
        </ul>
      </div>

      <!-- RECUADRO C: Contacto Directo (Centrado en Móvil) -->
      <div class="col-span-2 md:col-span-2 lg:col-span-1 text-center sm:text-left flex flex-col items-center sm:items-start pt-4 sm:pt-0 border-t sm:border-t-0 border-white/10">
        <h4 class="text-sm font-bold text-[#D4AF37] uppercase tracking-wider mb-4 font-['Barlow_Condensed'] border-b border-[#D4AF37]/30 pb-2 inline-block">Contacto Directo</h4>
        <div class="space-y-3 text-xs text-gray-400 font-['Barlow_Semi_Condensed'] flex flex-col items-center sm:items-start">
          <p class="flex items-center gap-2 justify-center sm:justify-start">
            <span class="text-[#D4AF37] font-bold">Teléfono / WA:</span>
            <a href="https://wa.me/18497527408" class="text-white hover:text-[#D4AF37] font-bold">+1 (849) 752-7408</a>
          </p>
          <p class="flex items-center gap-2 justify-center sm:justify-start">
            <span class="text-[#D4AF37] font-bold">Ubicación:</span>
            <span>República Dominicana & Punta Cana</span>
          </p>
          <p class="flex items-center gap-2 justify-center sm:justify-start">
            <span class="text-[#D4AF37] font-bold">Atención:</span>
            <span>24 Horas / 7 Días a la semana</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Barra Inferior de Copyright & Crédito a Goglite -->
    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-[11px] text-gray-500 gap-3 font-['Barlow_Condensed'] relative z-10 text-center sm:text-left">
      <p>© {currentYear} TurisRam Dominicana. Todos los derechos reservados.</p>
      
      <!-- Crédito de Creador "Creada por Goglite" -->
      <a
        href="https://goglite.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 hover:text-[#D4AF37] transition-colors font-bold tracking-wider text-xs flex items-center justify-center gap-1.5 font-['Barlow_Condensed']"
      >
        <span>Creada por</span>
        <span class="text-[#D4AF37] font-extrabold text-sm underline decoration-[#D4AF37]/40">Goglite</span>
      </a>
    </div>

  </div>

</footer>
