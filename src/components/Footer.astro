---
const currentYear = new Date().getFullYear();
const googleMapsLink = "https://www.google.com/maps/place/TurisRan+Dominicana+%7C+Transporte+%26+Tours/@18.5959418,-75.4170951,6z/data=!3m1!4b1!4m9!1m2!2m1!1sServicio+de+transporte!3m5!1s0x20c2c276dca7ff65:0xa77911ab58330602!8m2!3d18.6698995!4d-70.130055!16s%2Fg%2F11yf57_w_r";
---

<footer class="bg-[#030303] text-[#F7F5F0] pt-16 pb-8 border-t border-[#D4AF37]/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <!-- Column 1: Brand Info -->
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <img src="/images/logo-turisram.webp" alt="TurisRam Dominicana Logo" class="h-14 w-auto object-contain" />
        </a>
        <p class="text-xs text-gray-400 leading-relaxed font-['Barlow_Semi_Condensed']">
          Empresa líder en servicios de transporte privado VIP, traslados desde aeropuertos y tours exclusivos en la República Dominicana.
        </p>
        <p class="text-sm font-bold text-[#D4AF37] italic font-['Lora']">
          "Viaja cómodo. Llega seguro."
        </p>
        <div class="pt-1">
          <a
            href={googleMapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs text-[#D4AF37] hover:underline font-['Barlow_Condensed']"
          >
            <svg class="w-4 h-4 fill-current text-[#D4AF37]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            Ficha Oficial en Google Maps
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h4 class="text-sm font-bold text-[#D4AF37] uppercase tracking-wider mb-4 font-['Barlow_Condensed'] border-b border-[#D4AF37]/30 pb-2 inline-block">Navegación</h4>
        <ul class="space-y-2.5 text-xs text-gray-400 font-['Barlow_Condensed']">
          <li><a href="/" class="hover:text-[#D4AF37] transition-colors">Inicio</a></li>
          <li><a href="/nosotros" class="hover:text-[#D4AF37] transition-colors">Sobre Nosotros</a></li>
          <li><a href="/servicios" class="hover:text-[#D4AF37] transition-colors">Servicios & Tours</a></li>
          <li><a href="/contacto" class="hover:text-[#D4AF37] transition-colors">Contacto & Cotización</a></li>
        </ul>
      </div>

      <!-- Column 3: Cobertura Aeropuertos -->
      <div>
        <h4 class="text-sm font-bold text-[#3B6998] uppercase tracking-wider mb-4 font-['Barlow_Condensed'] border-b border-[#3B6998]/30 pb-2 inline-block">Cobertura de Aeropuertos</h4>
        <ul class="space-y-2.5 text-xs text-gray-400 font-['Barlow_Semi_Condensed']">
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Aeropuerto Int. Punta Cana (PUJ)</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Aeropuerto Las Américas (SDQ)</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Aeropuerto La Romana (LRM)</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Aeropuerto Cibao Santiago (STI)</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-[#3B6998] fill-current" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            <span>Aeropuerto Puerto Plata (POP)</span>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contacto Oficial -->
      <div>
        <h4 class="text-sm font-bold text-[#D4AF37] uppercase tracking-wider mb-4 font-['Barlow_Condensed'] border-b border-[#D4AF37]/30 pb-2 inline-block">Contacto Directo</h4>
        <div class="space-y-3 text-xs text-gray-400 font-['Barlow_Semi_Condensed']">
          <p class="flex items-center gap-2">
            <span class="text-[#D4AF37] font-bold">Teléfono / WA:</span>
            <a href="https://wa.me/18497527408" class="text-white hover:text-[#D4AF37] font-bold">+1 (849) 752-7408</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[#D4AF37] font-bold">Ubicación:</span>
            <span>República Dominicana & Punta Cana</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-[#D4AF37] font-bold">Atención:</span>
            <span>24 Horas / 7 Días a la semana</span>
          </p>
        </div>
      </div>

    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between text-[11px] text-gray-500 gap-4 font-['Barlow_Condensed']">
      <p>© {currentYear} TurisRam Dominicana. Todos los derechos reservados.</p>
      <p class="text-[#D4AF37] italic font-['Lora']">"Viaja cómodo. Llega seguro."</p>
    </div>
  </div>
</footer>
