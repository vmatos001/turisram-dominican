---
const phone = "18497527408";
---

<div class="glass-panel text-white p-6 sm:p-10 rounded-3xl shadow-2xl border border-[#D4AF37]/35 max-w-5xl mx-auto my-8">
  
  <!-- Header -->
  <div class="text-center mb-8">
    <span class="inline-flex items-center gap-2 bg-[#D4AF37] text-[#0A0A0A] text-[11px] font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-3 font-['Montserrat'] shadow-md">
      <svg class="w-3.5 h-3.5 fill-current text-[#0A0A0A]" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
      Cotizador en Tiempo Real
    </span>
    <h3 class="text-2xl sm:text-3xl font-extrabold text-white font-['Montserrat'] tracking-tight">
      Cotiza tu Traslado o Tour Privado
    </h3>
    <p class="text-xs sm:text-sm text-[#F7F5F0]/80 mt-1 max-w-xl mx-auto italic font-['Lora']">
      "Viaja cómodo. Llega seguro." — Recibe tu propuesta personalizada directamente en WhatsApp.
    </p>
  </div>

  <!-- Form -->
  <form id="quote-form" class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Origen -->
      <div class="bg-[#050505]/80 p-3.5 rounded-2xl border border-[#D4AF37]/20">
        <label class="block text-[11px] font-bold text-[#D4AF37] uppercase tracking-wider mb-1.5 font-['Montserrat'] flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 fill-current text-[#3B6998]" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
          Punto de Origen
        </label>
        <select id="origin" required class="w-full bg-transparent text-sm text-white focus:outline-none cursor-pointer">
          <option value="Aeropuerto Int. Punta Cana (PUJ)" class="bg-[#050505]">Aeropuerto Punta Cana (PUJ)</option>
          <option value="Aeropuerto Las Américas Santo Domingo (SDQ)" class="bg-[#050505]">Aeropuerto Santo Domingo (SDQ)</option>
          <option value="Aeropuerto La Romana (LRM)" class="bg-[#050505]">Aeropuerto La Romana (LRM)</option>
          <option value="Aeropuerto Cibao Santiago (STI)" class="bg-[#050505]">Aeropuerto Santiago (STI)</option>
          <option value="Aeropuerto Puerto Plata (POP)" class="bg-[#050505]">Aeropuerto Puerto Plata (POP)</option>
          <option value="Hotel / Resort / Airbnb" class="bg-[#050505]">Hotel / Resort / Villa Privada</option>
        </select>
      </div>

      <!-- Destino -->
      <div class="bg-[#050505]/80 p-3.5 rounded-2xl border border-[#D4AF37]/20">
        <label class="block text-[11px] font-bold text-[#D4AF37] uppercase tracking-wider mb-1.5 font-['Montserrat'] flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 fill-current text-[#3B6998]" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          Destino Turístico
        </label>
        <select id="destination" required class="w-full bg-transparent text-sm text-white focus:outline-none cursor-pointer">
          <option value="Bávaro / Punta Cana Resorts" class="bg-[#050505]">Bávaro / Punta Cana</option>
          <option value="Cap Cana VIP" class="bg-[#050505]">Cap Cana</option>
          <option value="Uvero Alto" class="bg-[#050505]">Uvero Alto</option>
          <option value="Bayahíbe / La Romana" class="bg-[#050505]">Bayahíbe / La Romana</option>
          <option value="Santo Domingo Centro" class="bg-[#050505]">Santo Domingo</option>
          <option value="Samaná / Las Terrenas" class="bg-[#050505]">Samaná / Las Terrenas</option>
          <option value="Jarabacoa / Constanza" class="bg-[#050505]">Jarabacoa / Constanza</option>
          <option value="Excursión Isla Saona / Otro" class="bg-[#050505]">Excursión / Otro Destino</option>
        </select>
      </div>

      <!-- Pasajeros / Vehiculo -->
      <div class="bg-[#050505]/80 p-3.5 rounded-2xl border border-[#D4AF37]/20">
        <label class="block text-[11px] font-bold text-[#D4AF37] uppercase tracking-wider mb-1.5 font-['Montserrat'] flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 fill-current text-[#3B6998]" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          Pasajeros & Vehículo
        </label>
        <select id="passengers" required class="w-full bg-transparent text-sm text-white focus:outline-none cursor-pointer">
          <option value="1-4 Pasajeros (Van Privada Exec)" class="bg-[#050505]">1 a 4 Pax (Van Exec)</option>
          <option value="5-8 Pasajeros (Van XL SUV)" class="bg-[#050505]">5 a 8 Pax (Van XL)</option>
          <option value="9-15 Pasajeros (Minibús VIP)" class="bg-[#050505]">9 a 15 Pax (Minibús VIP)</option>
          <option value="16+ Pasajeros (Autobús Turístico)" class="bg-[#050505]">16+ Pax (Grupo Grande)</option>
        </select>
      </div>

      <!-- Boton submit -->
      <div class="flex items-end">
        <button
          type="submit"
          class="w-full bg-[#D4AF37] text-[#050505] font-bold text-xs uppercase tracking-wider py-4 px-4 rounded-2xl hover:bg-white transition-all duration-300 flex items-center justify-center gap-2 shadow-xl font-['Montserrat'] border border-white/20"
        >
          <svg class="w-4 h-4 fill-current text-[#050505]" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.758zm6.657-4.148l.38.225c1.47.872 3.176 1.332 4.92 1.333 5.385 0 9.768-4.383 9.771-9.768.002-2.607-1.013-5.059-2.86-6.907-1.847-1.847-4.298-2.862-6.906-2.863-5.386 0-9.77 4.384-9.773 9.77-.001 1.794.49 3.541 1.42 5.061l.247.4-.954 3.484 3.575-.935z"/></svg>
          Solicitar Propuesta
        </button>
      </div>

    </div>
  </form>

</div>

<script is:inline>
  document.getElementById('quote-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const origin = document.getElementById('origin').value;
    const dest = document.getElementById('destination').value;
    const pax = document.getElementById('passengers').value;
    
    const text = `¡Hola TurisRam Dominicana! Deseo cotizar un servicio de transporte privado:%0A• Origen: ${origin}%0A• Destino: ${dest}%0A• Personas: ${pax}`;
    window.open(`https://wa.me/18497527408?text=${text}`, '_blank');
  });
</script>
