---
const phone = "18497527408";
---

<div class="bg-[#123458] text-white p-6 sm:p-8 rounded-3xl shadow-2xl border border-white/10 max-w-4xl mx-auto my-8">
  <div class="text-center mb-6">
    <span class="inline-block bg-[#D4C9BE] text-[#123458] text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider mb-2 font-['Montserrat']">
      Reserva Rápida y Cotización Inmediata
    </span>
    <h3 class="text-2xl sm:text-3xl font-extrabold text-white font-['Montserrat']">
      Cotiza tu Traslado Privado en República Dominicana
    </h3>
    <p class="text-sm text-[#F1EFEC]/80 mt-1 max-w-xl mx-auto">
      Sin pagos ocultos ni sorpresas en el aeropuerto. Recibe tu precio fijo directamente por WhatsApp.
    </p>
  </div>

  <form id="quote-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Origen -->
    <div>
      <label class="block text-xs font-bold text-[#D4C9BE] uppercase tracking-wide mb-1 font-['Montserrat']">Origen</label>
      <select id="origin" required class="w-full bg-[#030303]/60 border border-white/20 rounded-xl px-3.5 py-3 text-sm text-white focus:outline-none focus:border-[#D4C9BE]">
        <option value="Aeropuerto Int. Punta Cana (PUJ)">Aeropuerto Punta Cana (PUJ)</option>
        <option value="Aeropuerto Las Américas (SDQ)">Aeropuerto Santo Domingo (SDQ)</option>
        <option value="Aeropuerto La Romana (LRM)">Aeropuerto La Romana (LRM)</option>
        <option value="Aeropuerto Cibao Santiago (STI)">Aeropuerto Santiago (STI)</option>
        <option value="Aeropuerto Puerto Plata (POP)">Aeropuerto Puerto Plata (POP)</option>
        <option value="Hotel / Zona Turística">Hotel / Resort / Airbnb</option>
      </select>
    </div>

    <!-- Destino -->
    <div>
      <label class="block text-xs font-bold text-[#D4C9BE] uppercase tracking-wide mb-1 font-['Montserrat']">Destino</label>
      <select id="destination" required class="w-full bg-[#030303]/60 border border-white/20 rounded-xl px-3.5 py-3 text-sm text-white focus:outline-none focus:border-[#D4C9BE]">
        <option value="Bávaro / Punta Cana Resorts">Bávaro / Punta Cana</option>
        <option value="Cap Cana">Cap Cana</option>
        <option value="Uvero Alto">Uvero Alto</option>
        <option value="Bayahíbe / La Romana">Bayahíbe / La Romana</option>
        <option value="Santo Domingo Centro">Santo Domingo</option>
        <option value="Samaná / Las Terrenas">Samaná / Las Terrenas</option>
        <option value="Jarabacoa / Constanza">Jarabacoa / Constanza</option>
        <option value="Otro Destino">Otro Destino</option>
      </select>
    </div>

    <!-- Pasajeros -->
    <div>
      <label class="block text-xs font-bold text-[#D4C9BE] uppercase tracking-wide mb-1 font-['Montserrat']">Pasajeros</label>
      <select id="passengers" required class="w-full bg-[#030303]/60 border border-white/20 rounded-xl px-3.5 py-3 text-sm text-white focus:outline-none focus:border-[#D4C9BE]">
        <option value="1-4 Pasajeros (Van Privada)">1 a 4 Pasajeros (Van Standard)</option>
        <option value="5-8 Pasajeros (Van Ejecutiva)">5 a 8 Pasajeros (Van Ejecutiva)</option>
        <option value="9-15 Pasajeros (Minibús)">9 a 15 Pasajeros (Minibús VIP)</option>
        <option value="16+ Pasajeros (Grupo Grande)">16+ Pasajeros (Grupo Grande)</option>
      </select>
    </div>

    <!-- Botón Cotizar -->
    <div class="flex items-end">
      <button
        type="submit"
        class="w-full bg-[#D4C9BE] text-[#123458] font-bold text-sm py-3 px-4 rounded-xl hover:bg-white transition-all duration-300 flex items-center justify-center gap-2 shadow-lg font-['Montserrat']"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.758zm6.657-4.148l.38.225c1.47.872 3.176 1.332 4.92 1.333 5.385 0 9.768-4.383 9.771-9.768.002-2.607-1.013-5.059-2.86-6.907-1.847-1.847-4.298-2.862-6.906-2.863-5.386 0-9.77 4.384-9.773 9.77-.001 1.794.49 3.541 1.42 5.061l.247.4-.954 3.484 3.575-.935z"/></svg>
        Cotizar en 1 min
      </button>
    </div>
  </form>
</div>

<script is:inline>
  document.getElementById('quote-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const origin = document.getElementById('origin').value;
    const dest = document.getElementById('destination').value;
    const pax = document.getElementById('passengers').value;
    
    const text = `¡Hola TurisRam Dominican! Me gustaría cotizar un traslado privado:%0A• Origen: ${origin}%0A• Destino: ${dest}%0A• Personas: ${pax}`;
    window.open(`https://wa.me/18497527408?text=${text}`, '_blank');
  });
</script>
